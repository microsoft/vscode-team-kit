// need: code. The code itself: the key lines, a diff, notes on what each part does.
import { defineTreatment } from '../engine/scene.js';
import { C, STEP, TONE } from '../theme/tokens.js';
import { badge, card, connector, el, svgLayer, tile, txt } from '../theme/primitives.js';
import { codePanel, diffPanel } from '../theme/code.js';
import { decel, enter, prog, standard } from '../engine/motion.js';
import { code as codeRef, label } from '../engine/text.js';
import { header, need, spread } from './kit.js';

/** A code panel on the left; numbered notes on the right; the focus band moves to each note's lines. */
export const walkthrough = defineTreatment({
	id: 'code.walkthrough',
	need: 'code',
	name: 'Code walkthrough',
	when: 'One function (up to ~30 lines) is the heart of the PR; 2-4 notes explain its parts in order.',
	params: {
		eyebrow: 'label', title: 'label',
		block: 'code(file, { from, to }) or code(file, { anchor, block: true })',
		notes: '[{ lines: [from, to], title, text, at }]  (2-4)',
	},
	demo: () => ({
		eyebrow: label('The code'), title: label('One function does the work'),
		block: codeRef('demo/src/cache.ts', { from: 1, to: 16 }),
		notes: [{ lines: [3, 5], title: label('Look it up'), text: label('return the cached value when it is fresh') }, { lines: [7, 10], title: label('Load it'), text: label('read once, then remember') }, { lines: [12, 14], title: label('Invalidate'), text: label('drop it when the file changes') }],
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const block = ctx.code(p.block);
		const notes = p.notes ?? [];
		need(notes.length >= 1 && notes.length <= 4, 'code.walkthrough: 1-4 notes');
		const times = spread(ctx, notes, { lead: 1.0, tail: 1.4 });
		const panel = codePanel(root, block, { x: 96, y: 236, w: 1150, h: 664, revealAt: ctx.beat.start + 0.5, focus: notes.map((n, k) => ({ at: times[k], from: n.lines[0], to: n.lines[1] })) });
		const noteH = Math.min(150, (664 - (notes.length - 1) * 18) / notes.length);
		const noteEls = notes.map((n, k) => {
			const c = card(root, { left: 1282, top: 236 + k * (noteH + 18), width: 542, height: noteH, padding: '22px 26px 0 82px' });
			const bar = el('div', 'st-abs', c, { left: 0, top: 0, bottom: 0, width: 6, borderRadius: '18px 0 0 18px', background: STEP[k % STEP.length], transformOrigin: '50% 50%' });
			badge(c, { n: k + 1, size: 38, color: STEP[k % STEP.length], style: { position: 'absolute', left: 26, top: 22 } });
			txt(c, n.title, 'st-h4', { display: 'block', fontSize: 25, whiteSpace: 'nowrap' }, 'div');
			if (n.text) {
				txt(c, n.text, 'st-small', { display: 'block', marginTop: 6, fontSize: 19 }, 'div');
			}
			txt(c, label(`lines ${n.lines[0]}\u2013${n.lines[1]}`), 'st-mono st-abs', { right: 22, top: 26, fontSize: 15, color: C.muted }, 'div');
			return { c, bar };
		});
		return { h, panel, noteEls, times };
	},
	render(i, t) {
		i.h.render(t);
		i.panel.render(t);
		i.noteEls.forEach((n, k) => {
			const at = i.times[k];
			enter(n.c, t, at - 0.2, { dx: 16, dy: 0 });
			const next = i.times[k + 1] ?? Infinity;
			const active = t >= at && t < next;
			n.c.style.borderColor = active ? STEP[k % STEP.length] : C.line;
			n.c.style.opacity = String(Number(n.c.style.opacity) * (t >= next ? 0.55 : 1));
			n.bar.style.transform = `scaleY(${decel(prog(t, at, at + 0.4))})`;
		});
	},
});

/** The diff itself: removed and added lines, with callouts pinned to the lines that matter. */
export const diff = defineTreatment({
	id: 'code.diff',
	need: 'code',
	name: 'Diff with callouts',
	when: 'The change is small and the exact lines tell the story (a condition flipped, a guard added, a value changed). Up to ~18 diff lines.',
	params: {
		eyebrow: 'label', title: 'label',
		hunk: 'code(file, { diff: true, anchor })  (optionally from/to to trim)',
		callouts: '[{ line: line number (new, or old for a removed line), text, tone, at }]  (1-4)',
	},
	demo: () => ({
		eyebrow: label('The change'), title: label('The guard moves before the write'),
		hunk: codeRef('demo/src/cache.ts', { diff: true, anchor: 'isStale' }),
		callouts: [{ line: 4, text: label('checked first now'), tone: 'green' }],
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const hunk = ctx.code(p.hunk);
		need(hunk.kind === 'diff', 'code.diff needs code(file, { diff: true, ... })');
		const panel = diffPanel(root, hunk, { x: 96, y: 236, w: 1180, h: 664, revealAt: ctx.beat.start + 0.5 });
		const svg = svgLayer(root);
		const callouts = p.callouts ?? [];
		need(callouts.length <= 4, 'code.diff: at most 4 callouts');
		const times = spread(ctx, callouts, { lead: 1.6, tail: 1.2 });
		let floor = 236;
		const els = callouts.map((c, k) => {
			const idx = hunk.lines.findIndex(l => l.new === c.line && l.type !== '-') >= 0 ? hunk.lines.findIndex(l => l.new === c.line && l.type !== '-') : hunk.lines.findIndex(l => l.old === c.line);
			need(idx >= 0, `callout line ${c.line} is not in the hunk`);
			const rowY = 236 + 58 + 10 + idx * panel.ROW + panel.ROW / 2;
			const y = Math.max(floor, rowY - 40);
			const tone = c.tone ?? 'blue';
			const box = tile(root, tone, { left: 1340, top: y, width: 484, height: 80, display: 'flex', alignItems: 'center', padding: '0 24px' });
			txt(box, c.text, '', { fontSize: 22, fontWeight: 600, color: C.ink, lineHeight: 1.25 });
			floor = y + 96;
			const line = connector(svg, [[1284, rowY], [1312, rowY], [1312, y + 40], [1332, y + 40]], { color: TONE[tone].fg, width: 2.5, head: false, radius: 8 });
			const row = panel.rows[idx];
			return { box, line, row, tone };
		});
		return { h, panel, els, times };
	},
	render(i, t) {
		i.h.render(t);
		i.panel.render(t);
		i.els.forEach((e, k) => {
			const at = i.times[k];
			e.line.render(t, at, 0.4);
			enter(e.box, t, at + 0.2, { dx: 14, dy: 0 });
			const glow = standard(prog(t, at, at + 0.3));
			e.row.style.boxShadow = glow > 0.5 ? `inset 4px 0 0 ${TONE[e.tone].fg}` : 'none';
		});
	},
});


==> catalog/compare.js  text 10550
// need: compare. Behavior before and after the change.
import { defineTreatment } from '../engine/scene.js';
import { C, TONE } from '../theme/tokens.js';
import { card, el, icon, iconTile, pill, tile, txt } from '../theme/primitives.js';
import { clamp, enter, lerp, prog, standard } from '../engine/motion.js';
import { label } from '../engine/text.js';
import { header, need, spread } from './kit.js';

/** Before | After, row by row; rows that change are tinted. Optional bottom line with the takeaway. */
export const split = defineTreatment({
	id: 'compare.split',
	need: 'compare',
	name: 'Before and after',
	when: 'Behavior that differs on 2-5 aspects (what the user sees, what is sent, what is cached). The narration names the aspects in order, a sentence each, and each row lands on its word; or it tells the old way first and turns on "Now" (afterAt: the whole new column then).',
	params: {
		eyebrow: 'label', title: 'label',
		before: '{ title, icon }', after: '{ title, icon }',
		rows: '[{ aspect, before, after, changed (default true), mono, at, afterAt }]  (1-5; mono is for the whole row)',
		afterAt: 'time the new column appears, row after row (optional: by default each row\'s new side follows its old one)',
		takeaway: '{ text, tone, at }  (optional)',
	},
	demo: () => ({
		eyebrow: label('What changes'), title: label('Same request, safer result'),
		before: { title: label('Before') }, after: { title: label('Now') },
		rows: [{ aspect: label('Error shown'), before: label('Access denied'), after: label('Sign in to continue') }, { aspect: label('User can fix it'), before: label('no'), after: label('yes') }, { aspect: label('Requests sent'), before: label('one'), after: label('one'), changed: false }],
		takeaway: { text: label('The fix is in the message, not the request') },
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const rows = p.rows ?? [];
		need(rows.length >= 1 && rows.length <= 5, 'compare.split: 1-5 rows');
		const aspectW = 380, colW = (1728 - aspectW - 2 * 24) / 2;
		const xB = 96 + aspectW + 24, xA = xB + colW + 24;
		const top = 250;
		const headB = tile(root, 'neutral', { left: xB, top, width: colW, height: 64, display: 'flex', alignItems: 'center', gap: 14, padding: '0 26px' });
		icon(headB, p.before?.icon ?? 'history', 28, C.body);
		txt(headB, p.before?.title ?? label('Before'), '', { fontSize: 24, fontWeight: 600, color: C.body });
		const headA = tile(root, 'blue', { left: xA, top, width: colW, height: 64, display: 'flex', alignItems: 'center', gap: 14, padding: '0 26px' });
		icon(headA, p.after?.icon ?? 'sparkle', 28, C.blue);
		txt(headA, p.after?.title ?? label('After'), '', { fontSize: 24, fontWeight: 600, color: C.blue });
		const rowH = Math.min(104, (p.takeaway ? 520 : 620) / rows.length);
		const rowEls = rows.map((r, k) => {
			const y = top + 88 + k * rowH;
			const changed = r.changed !== false;
			const aspect = txt(root, r.aspect, 'st-abs', { left: 96, top: y, width: aspectW, height: rowH - 14, display: 'flex', alignItems: 'center', fontSize: 23, fontWeight: 600, color: C.ink }, 'div');
			const b = card(root, { left: xB, top: y, width: colW, height: rowH - 14, display: 'flex', alignItems: 'center', padding: '0 26px' });
			txt(b, r.before, r.mono ? 'st-mono' : '', { fontSize: r.mono ? 21 : 23, color: changed ? C.body : C.ink, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' });
			const a = card(root, { left: xA, top: y, width: colW, height: rowH - 14, display: 'flex', alignItems: 'center', padding: '0 26px', gap: 14 });
			if (changed) {
				icon(a, 'arrowRight', 22, C.green);
			}
			txt(a, r.after, r.mono ? 'st-mono' : '', { fontSize: r.mono ? 21 : 23, fontWeight: changed ? 600 : 400, color: changed ? C.green : C.ink, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' });
			return { aspect, b, a, changed, afterAt: r.afterAt !== undefined ? ctx.at(r.afterAt) : null };
		});
		let take = null;
		if (p.takeaway) {
			const tone = p.takeaway.tone ?? 'green';
			take = tile(root, tone, { left: 96, top: top + 88 + rows.length * rowH + 22, width: 1728, height: 76, display: 'flex', alignItems: 'center', gap: 16, padding: '0 30px' });
			icon(take, 'check', 28, TONE[tone].fg);
			txt(take, p.takeaway.text, '', { fontSize: 25, fontWeight: 600, color: C.ink, whiteSpace: 'nowrap' });
		}
		const times = spread(ctx, rows, { lead: 1.2, tail: p.takeaway ? 2.6 : 1.2 });
		// When the new side shows: the row's own afterAt, else the column's (row after row), else just after its old side.
		const column = p.afterAt !== undefined ? ctx.at(p.afterAt) : null;
		const afterTimes = rowEls.map((r, k) => r.afterAt ?? (column !== null ? column + k * 0.3 : times[k] + 0.35));
		// Without its own time, the takeaway comes after the last row, never before it.
		const takeAt = !p.takeaway ? 0 : p.takeaway.at !== undefined ? ctx.at(p.takeaway.at) : Math.max(ctx.at(undefined, Math.max(1, ctx.beat.duration - 2)), Math.max(...times, ...afterTimes) + 0.8);
		return { h, headB, headA, rowEls, take, times, afterTimes, takeAt, headAt: column !== null ? column - 0.25 : ctx.beat.start + 0.55 };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		enter(i.headB, t, s + 0.4, { dy: 10 });
		enter(i.headA, t, i.headAt, { dy: 10 });
		i.rowEls.forEach((r, k) => {
			const at = i.times[k];
			enter(r.aspect, t, at - 0.3, { dx: -10, dy: 0 });
			enter(r.b, t, at - 0.2, { dy: 8 });
			const q = enter(r.a, t, i.afterTimes[k], { dx: -16, dy: 0 });
			r.a.style.background = r.changed && q > 0.5 ? C.greenTint : '#fff';
			r.a.style.borderColor = r.changed && q > 0.5 ? 'transparent' : C.line;
		});
		if (i.take) {
			enter(i.take, t, i.takeAt, { dy: 12 });
		}
	},
});

function screen(root, side, { x, y, w, h, tone }) {
	const c = card(root, { left: x, top: y, width: w, height: h, overflow: 'hidden' });
	const bar = el('div', '', c, { height: 64, display: 'flex', alignItems: 'center', gap: 14, padding: '0 28px', borderBottom: `1.5px solid ${C.line}`, background: '#fff' });
	iconTile(bar, side.icon ?? 'window', { tone, size: 40 });
	txt(bar, side.title, '', { fontSize: 23, fontWeight: 600, color: C.ink, whiteSpace: 'nowrap' });
	const list = el('div', '', c, { padding: '26px 28px', display: 'flex', flexDirection: 'column', gap: 16 });
	for (const it of side.items ?? []) {
		const row = el('div', '', list, { display: 'flex', alignItems: 'center', gap: 18, height: 72, borderRadius: 12, background: TONE[it.tone ?? 'neutral'].tint, padding: '0 26px', flex: 'none' });
		row.dataset.box = 'tile';
		if (it.icon) {
			icon(row, it.icon, 26, TONE[it.tone ?? 'neutral'].fg);
		}
		txt(row, it.text, it.mono ? 'st-mono' : '', { fontSize: it.mono ? 23 : 26, color: C.ink, whiteSpace: 'nowrap', fontWeight: it.tone && it.tone !== 'neutral' ? 600 : 400 });
	}
	return c;
}

/** The same panel before and after: a wipe line sweeps across and reveals the new state in place. */
export const wipe = defineTreatment({
	id: 'compare.wipe',
	need: 'compare',
	name: 'Wipe reveal',
	when: 'One screen, list or result that looks different after the change; the viewer sees it flip in place. The narration says what it was, then what it is now: the wipe lands on the word that turns ("Now"). The whole panel turns at once, and its items flip in place: give before and after the same rows in the same order.',
	params: {
		eyebrow: 'label', title: 'label',
		before: '{ title, icon, items: [{ icon, text, tone, mono }] }  (2-6 items)',
		after: '{ title, icon, items: [...] }',
		at: 'time of the wipe', note: '{ before, after }  (labels under the panel)',
	},
	demo: () => ({
		eyebrow: label('The result'), title: label('Search now ranks exact matches first'),
		before: { title: label('Results'), items: [{ icon: 'document', text: label('readme-old.md') }, { icon: 'document', text: label('my-readme.txt') }, { icon: 'document', text: label('README.md') }] },
		after: { title: label('Results'), items: [{ icon: 'document', text: label('README.md'), tone: 'green' }, { icon: 'document', text: label('readme-old.md') }, { icon: 'document', text: label('my-readme.txt') }] },
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		need(p.before && p.after, 'compare.wipe needs before and after');
		const w = 1320, x = (1920 - w) / 2, y = 250;
		const n = Math.max(p.before.items?.length ?? 0, p.after.items?.length ?? 0);
		need(n <= 6, 'compare.wipe: at most 6 items');
		const hh = Math.min(580, 64 + 52 + n * 88);
		const before = screen(root, p.before, { x, y, w, h: hh, tone: 'neutral' });
		const after = screen(root, p.after, { x, y, w, h: hh, tone: 'blue' });
		before.dataset.exclusive = 'wipe:before';
		after.dataset.exclusive = 'wipe:after';
		const line = el('div', 'st-abs', root, { left: x, top: y - 14, width: 4, height: hh + 28, borderRadius: 2, background: C.blue });
		const handle = el('div', 'st-abs', root, { left: x - 60, top: y + hh / 2 - 17, width: 120, display: 'flex', justifyContent: 'center' });
		// It sweeps across the rows on purpose: a moving part, which the overlap check leaves alone.
		handle.dataset.flight = 'wipe';
		pill(handle, { tone: 'blue', text: label('after'), solid: true, size: 's' });
		const tagB = el('div', 'st-abs', root, { left: x, top: y + hh + 26 });
		pill(tagB, { tone: 'neutral', text: p.note?.before ?? label('before'), size: 's' });
		const tagA = el('div', 'st-abs', root, { right: 1920 - x - w, top: y + hh + 26 });
		pill(tagA, { tone: 'blue', text: p.note?.after ?? label('after this PR'), size: 's' });
		return { h, before, after, line, handle, tagB, tagA, x, w, at: ctx.at(p.at, Math.max(1.5, ctx.beat.duration * 0.45)) };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		enter(i.before, t, s + 0.45, { dy: 16 });
		enter(i.tagB, t, s + 0.8, { dy: 6 });
		const p = standard(prog(t, i.at, i.at + 1.1));
		const edge = lerp(i.w, 0, p);
		i.after.style.clipPath = `inset(0 0 0 ${edge}px round 18px)`;
		i.after.style.opacity = p > 0 ? '1' : '0';
		i.before.style.clipPath = `inset(0 ${i.w - edge}px 0 0 round 18px)`;
		if (p >= 1) {
			i.before.style.opacity = '0';
		}
		const visible = clamp(prog(t, i.at - 0.2, i.at)) * (1 - clamp(prog(t, i.at + 1.1, i.at + 1.4)));
		i.line.style.transform = `translateX(${edge - 2}px)`;
		i.line.style.opacity = String(visible);
		i.handle.style.transform = `translateX(${edge}px)`;
		i.handle.style.opacity = String(visible);
		i.tagB.style.opacity = String(Number(i.tagB.style.opacity) * (1 - p));
		enter(i.tagA, t, i.at + 1.0, { dy: 6 });
	},
});

==> catalog/concept.js  text 14494
// need: concept. A problem, a mismatch, or a few ideas side by side.
import { defineTreatment } from '../engine/scene.js';
import { C, TONE, STEP } from '../theme/tokens.js';
import { card, cardHead, connector, el, icon, pill, svgLayer, tile, txt, badge } from '../theme/primitives.js';
import { decel, enter, prog, standard } from '../engine/motion.js';
import { label } from '../engine/text.js';
import { header, need, spread } from './kit.js';

/**
 * What you have vs what is required: a card with properties (each ok or not), a link with a verdict,
 * a card with the requirement. Optional footer: a row of related cards (for "and it can't simply be ...").
 */
export const mismatch = defineTreatment({
	id: 'concept.mismatch',
	need: 'concept',
	name: 'Have vs need',
	when: 'The problem is a mismatch: what something is vs what is required (a token, a format, a permission, a version). The requirement (need) shows first, by default 0.4 s in, then what there is (have) and its rows: narrate the requirement first, or time need.at to its words.',
	params: {
		eyebrow: 'label', title: 'label',
		have: '{ icon, title, rows: [{ key, value, ok, at }] }  (2-3 rows)',
		link: '{ label, verdict: { text, tone }, at }',
		need: '{ icon, title, sub, tone, requirement: { label, text }, at }',
		footer: '{ lead, note, at, items: [{ icon, title, mono, label, value, sub, chip, tone, at }] }  (optional, 1-4 items)',
	},
	demo: () => ({
		eyebrow: label('The problem'), title: label('A cached file isn\u2019t the file on disk'),
		have: { icon: 'document', title: label('Cached copy'), rows: [{ key: label('Path'), value: label('the same path'), ok: true }, { key: label('Version'), value: label('read an hour ago'), ok: false }] },
		link: { label: label('compared'), verdict: { text: label('stale'), tone: 'red' } },
		need: { icon: 'database', title: label('Editor'), sub: label('expects the latest content'), tone: 'blue', requirement: { label: label('Needs'), text: label('the version on disk now') } },
	}),
	mount(root, p, ctx) {
		need(p.have && p.need, 'concept.mismatch needs have and need');
		const h = header(root, p, ctx);
		const hasFooter = !!p.footer?.items?.length;
		const top = hasFooter ? 250 : 330;
		const rows = p.have.rows ?? [];
		need(rows.length <= 3, 'have.rows: at most 3');
		const haveH = 102 + rows.length * 70 + 2;
		const have = card(root, { left: 96, top, width: 620, height: haveH });
		const hh = el('div', 'st-abs', have, { left: 32, top: 26, right: 32 });
		cardHead(hh, { iconName: p.have.icon, title: p.have.title, tone: p.have.tone ?? 'blue' });
		ctx.anchor('have', hh);
		el('div', 'st-abs', have, { left: 0, right: 0, top: 102, height: 1.5, background: C.line });
		const rowNodes = rows.map((r, i) => {
			const row = el('div', 'st-abs', have, { left: 32, right: 32, top: 102 + i * 70, height: 70, display: 'flex', alignItems: 'center', gap: 20, borderTop: i ? `1.5px solid ${C.line}` : 'none' });
			txt(row, r.key, 'st-label', { minWidth: 64, flex: 'none' });
			txt(row, r.value, '', { fontSize: 23, color: r.ok === false ? C.red : C.ink, flex: 1, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', minWidth: 0 });
			const mark = r.ok === undefined ? null : icon(row, r.ok ? 'check' : 'dismiss', 28, r.ok ? C.green : C.red);
			return { row, mark, r };
		});
		const needCard = card(root, { left: 1180, top, width: 644, height: Math.max(haveH, 254) });
		const nh = el('div', 'st-abs', needCard, { left: 32, top: 30, right: 32 });
		ctx.anchor('need', nh);
		cardHead(nh, { iconName: p.need.icon, title: p.need.title, sub: p.need.sub, tone: p.need.tone ?? 'blue' });
		let req = null;
		if (p.need.requirement) {
			req = tile(needCard, p.need.tone ?? 'blue', { left: 32, right: 32, top: 132, height: 92, padding: '16px 24px' });
			txt(req, p.need.requirement.label ?? label('Requires'), 'st-label', { display: 'block', color: TONE[p.need.tone ?? 'blue'].fg, fontSize: 15 }, 'div');
			txt(req, p.need.requirement.text, '', { display: 'block', fontSize: 23, color: C.ink, marginTop: 8, whiteSpace: 'nowrap' }, 'div');
		}
		const svg = svgLayer(root);
		const midY = top + Math.min(haveH, 254) / 2;
		const link = connector(svg, [[744, midY], [1160, midY]], { color: C.connectorStrong, radius: 0 });
		const linkLabel = p.link?.label ? txt(root, p.link.label, 'st-abs', { left: 744, width: 416, top: midY - 46, textAlign: 'center', fontSize: 19, color: C.body }, 'div') : null;
		let verdict = null;
		if (p.link?.verdict) {
			verdict = el('div', 'st-abs', root, { left: 744, width: 416, top: midY + 22, display: 'flex', justifyContent: 'center' });
			pill(verdict, { tone: p.link.verdict.tone ?? 'red', iconName: p.link.verdict.tone === 'green' ? 'check' : 'dismiss', text: p.link.verdict.text, size: 's' });
		}
		let footer = null;
		if (hasFooter) {
			const items = p.footer.items;
			need(items.length <= 4, 'footer.items: at most 4');
			footer = { lead: p.footer.lead ? txt(root, p.footer.lead, 'st-abs', { left: 96, top: 572, fontSize: 25, fontWeight: 600, color: C.ink, whiteSpace: 'nowrap' }, 'div') : null };
			footer.note = p.footer.note ? txt(root, p.footer.note, 'st-abs', { right: 96, top: 576, fontSize: 21, fontWeight: 600, color: C.blue, whiteSpace: 'nowrap' }, 'div') : null;
			const first = items[0];
			const wide = !!(first.value || first.label);
			const firstW = wide ? 560 : 0;
			const rest = wide ? items.slice(1) : items;
			const restW = rest.length ? (1728 - firstW - (wide ? 24 : 0) - (rest.length - 1) * 24) / rest.length : 0;
			let x = 96;
			footer.cards = items.map((it, i) => {
				const w = wide && i === 0 ? firstW : restW;
				const c = card(root, { left: x, top: 630, width: w, height: 236 });
				x += w + 24;
				const head = el('div', 'st-abs', c, { left: 28, top: 26, right: 28 });
				cardHead(head, { iconName: it.icon, title: it.title, tone: it.tone ?? 'neutral', size: 's', mono: it.mono });
				if (it.label) {
					txt(c, it.label, 'st-label st-abs', { left: 28, top: 96, fontSize: 14 }, 'div');
				}
				if (it.value) {
					const box = el('div', 'st-abs', c, { left: 28, right: 28, top: 128, height: 56, borderRadius: 12, background: C.surface, display: 'flex', alignItems: 'center', padding: '0 20px' });
					box.dataset.box = 'tile';
					txt(box, it.value, 'st-mono', { fontSize: 18, color: C.body, whiteSpace: 'nowrap' });
				}
				if (it.sub) {
					txt(c, it.sub, 'st-abs', { left: 28, right: 28, top: it.label ? 132 : 92, fontSize: 18, lineHeight: 1.45, color: C.body }, 'div');
				}
				if (it.chip) {
					const chip = el('div', 'st-abs', c, { left: 28, right: 28, bottom: 22, height: 40, borderRadius: 10, background: TONE[it.tone ?? 'blue'].tint, display: 'flex', alignItems: 'center', padding: '0 16px' });
					chip.dataset.box = 'tile';
					txt(chip, it.chip, 'st-mono', { fontSize: 16, color: TONE[it.tone ?? 'blue'].fg, whiteSpace: 'nowrap' });
				}
				return c;
			});
			footer.times = spread(ctx, items, { lead: 3 });
			footer.at = ctx.at(p.footer.at, footer.times[0] - ctx.beat.start - 0.2);
		}
		const rowAt = spread(ctx, rows, { lead: 1.6, tail: 4 });
		return {
			h, have, rowNodes, needCard, req, link, linkLabel, verdict, footer, rowAt,
			needAt: ctx.at(p.need.at, 0.4),
			linkAt: p.link?.at !== undefined ? ctx.at(p.link.at) : (rowAt.at(-1) ?? ctx.beat.start + 2) + 0.8,
		};
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		enter(i.needCard, t, i.needAt, { dx: 18, dy: 0 });
		if (i.req) {
			enter(i.req, t, i.needAt + 0.3, { dy: 8 });
		}
		enter(i.have, t, Math.min(i.rowAt[0] ?? s + 1, i.needAt + 1.4) - 0.6, { dx: -18, dy: 0 });
		i.rowNodes.forEach((r, k) => {
			enter(r.row, t, i.rowAt[k] - 0.2, { dy: 6 });
			if (r.mark) {
				enter(r.mark, t, i.rowAt[k] + 0.1, { dy: 0, scale: 0.4, dur: 0.4 });
			}
		});
		const la = i.linkAt;
		i.link.render(t, la - 0.6, 0.6);
		if (i.linkLabel) {
			enter(i.linkLabel, t, la - 0.5, { dy: 6 });
		}
		if (i.verdict) {
			enter(i.verdict, t, la, { dy: 0, scale: 0.3, dur: 0.45 });
		}
		if (i.footer) {
			if (i.footer.lead) {
				enter(i.footer.lead, t, i.footer.at, { dy: 8 });
			}
			i.footer.cards.forEach((c, k) => enter(c, t, i.footer.times[k], { dy: 14 }));
			if (i.footer.note) {
				enter(i.footer.note, t, i.footer.times.at(-1) + 0.9, { dx: -10, dy: 0 });
			}
		}
	},
});

/** Two to four numbered ideas side by side; each appears when the narration reaches it. */
export const pillars = defineTreatment({
	id: 'concept.pillars',
	need: 'concept',
	name: 'Numbered pillars',
	when: 'Two to four ideas, parts or reasons of equal weight ("three things change").',
	params: { eyebrow: 'label', title: 'label', items: '[{ icon, title (about 3 words), text, code (a short code name under the text, drawn as code: ident() or quote(), not code()), at }]  (2-4)' },
	demo: () => ({ eyebrow: label('The idea'), title: label('Three things change'), items: [
		{ icon: 'search', title: label('Find'), text: label('Look up the setting once, at startup') },
		{ icon: 'flash', title: label('Cache'), text: label('Keep it in memory instead of reading it per call') },
		{ icon: 'sync', title: label('Refresh'), text: label('Reload it when the file changes') },
	] }),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const items = p.items ?? [];
		need(items.length >= 2 && items.length <= 4, 'concept.pillars: 2-4 items');
		const gap = 28, w = (1728 - gap * (items.length - 1)) / items.length, top = 286, height = 520;
		const cards = items.map((it, k) => {
			const c = tile(root, 'neutral', { left: 96 + k * (w + gap), top, width: w, height, padding: '40px 38px' });
			const row = el('div', '', c, { display: 'flex', alignItems: 'center', justifyContent: 'space-between' });
			badge(row, { n: k + 1, text: String(k + 1).padStart(2, '0'), size: 58, style: { borderRadius: 14 } });
			if (it.icon) {
				icon(row, it.icon, 44, STEP[k % STEP.length]);
			}
			txt(c, it.title, 'st-h3', { display: 'block', marginTop: 64, fontSize: items.length === 4 ? 30 : 34 }, 'div');
			if (it.text) {
				txt(c, it.text, 'st-body', { display: 'block', marginTop: 16, fontSize: items.length === 4 ? 22 : 24 }, 'div');
			}
			if (it.code) {
				const box = el('div', '', c, { position: 'absolute', left: 38, right: 38, bottom: 38, height: 56, borderRadius: 12, background: '#fff', border: `1.5px solid ${C.line}`, display: 'flex', alignItems: 'center', padding: '0 18px' });
				box.dataset.box = 'tile';
				txt(box, it.code, 'st-mono', { fontSize: 18, color: C.ink, whiteSpace: 'nowrap' });
			}
			const bar = el('div', '', c, { position: 'absolute', left: 0, top: 0, bottom: 0, width: 6, borderRadius: '18px 0 0 18px', background: STEP[k % STEP.length], transformOrigin: '50% 0' });
			return { c, bar };
		});
		return {
			h, cards, times: spread(ctx, items, { lead: 0.9, tail: 1.5 }),
			layout() {
				const content = Math.max(...cards.map(({ c }) => [...c.children].filter(n => getComputedStyle(n).position !== 'absolute').reduce((a, n) => Math.max(a, n.offsetTop + n.offsetHeight), 0)));
				const hh = Math.min(560, Math.max(320, content + 40 + (items.some(it => it.code) ? 70 : 0)));
				for (const { c } of cards) {
					c.style.height = `${hh}px`;
					c.style.top = `${250 + (650 - hh) / 2}px`;
				}
			},
		};
	},
	render(i, t) {
		i.h.render(t);
		i.cards.forEach(({ c, bar }, k) => {
			enter(c, t, i.times[k], { dy: 22 });
			bar.style.transform = `scaleY(${decel(prog(t, i.times[k] + 0.2, i.times[k] + 0.8))})`;
		});
	},
});

/** One big statement with the key phrase highlighted, and supporting chips underneath. */
export const statement = defineTreatment({
	id: 'concept.statement',
	need: 'concept',
	name: 'Statement',
	when: 'The point fits in one sentence ("the bug: X happens because Y"). Good for small PRs and for the problem beat.',
	params: { eyebrow: 'label', parts: '[text | { text, mark: tone, at }]  (the sentence; marked parts highlight at their time)', chips: '[{ icon, text, tone, at }]  (0-4; they wrap onto a second row past the width, so keep them short)' },
	demo: () => ({ eyebrow: label('The bug'), parts: [label('Saving a file '), { text: label('twice in a row'), mark: 'orange' }, label(' could '), { text: label('drop the second edit'), mark: 'red' }], chips: [{ icon: 'save', text: label('two saves within 50 ms') }, { icon: 'warning', text: label('one write lost'), tone: 'red' }] }),
	mount(root, p, ctx) {
		const parts = p.parts ?? [];
		need(parts.length, 'concept.statement needs parts');
		const eyebrow = p.eyebrow ? txt(root, p.eyebrow, 'st-eyebrow st-abs', { left: 160, top: 250 }, 'div') : null;
		const box = el('div', 'st-abs', root, { left: 160, top: 300, width: 1600, fontSize: 64, fontWeight: 600, lineHeight: 1.22, letterSpacing: '-.015em', color: C.ink });
		const marks = [];
		for (const part of parts) {
			if (part && part.mark) {
				const span = txt(box, part.text, '', { position: 'relative', whiteSpace: 'nowrap' });
				const hl = el('span', '', span, { position: 'absolute', left: -6, right: -6, bottom: 4, height: '0.36em', borderRadius: 6, background: TONE[part.mark].tint, zIndex: -1, transformOrigin: '0 50%' });
				span.style.zIndex = '0';
				marks.push({ span, hl, at: part.at, color: TONE[part.mark].fg });
			} else {
				txt(box, part);
			}
		}
		const chips = el('div', 'st-abs', root, { left: 160, top: 0, display: 'flex', gap: 16, flexWrap: 'wrap', width: 1600 });
		const chipNodes = (p.chips ?? []).map(c => pill(chips, { tone: c.tone ?? 'neutral', iconName: c.icon, text: c.text, size: 'l' }));
		return {
			eyebrow, box, marks, chips, chipNodes,
			markAt: spread(ctx, marks, { lead: 1.2, tail: 2 }),
			chipAt: spread(ctx, p.chips ?? [], { lead: 2.5, tail: 1 }),
			layout() {
				const bottom = box.offsetTop + box.offsetHeight;
				const offset = Math.max(0, (900 - (bottom + 60 + (chipNodes.length ? 60 : 0)) - 250) / 2);
				for (const n of [eyebrow, box].filter(Boolean)) {
					n.style.top = `${parseFloat(n.style.top) + offset}px`;
				}
				chips.style.top = `${box.offsetTop + box.offsetHeight + 56}px`;
			},
		};
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		if (i.eyebrow) {
			enter(i.eyebrow, t, s, { dy: 8 });
		}
		enter(i.box, t, s + 0.1, { dy: 16, dur: 0.8 });
		i.marks.forEach((m, k) => {
			const p = standard(prog(t, i.markAt[k], i.markAt[k] + 0.5));
			m.hl.style.transform = `scaleX(${p})`;
			m.span.style.color = p > 0.5 ? m.color : C.ink;
		});
		i.chipNodes.forEach((c, k) => enter(c, t, i.chipAt[k], { dy: 10 }));
	},
});

==> catalog/exchange.js  text 14219
// need: exchange. Messages between parties: a protocol, a handshake, a request and its reply.
import { defineTreatment } from '../engine/scene.js';
import { C, TONE } from '../theme/tokens.js';
import { arrow, badge, card, cardHead, connector, el, iconTile, pill, svgLayer, txt } from '../theme/primitives.js';
import { codeLabel, codeStrip } from '../theme/code.js';
import { clamp, decel, enter, prog, standard } from '../engine/motion.js';
import { label } from '../engine/text.js';
import { columnsX, header, need, spread } from './kit.js';

/**
 * Sequence diagram: parties as lifelines, numbered request/reply pairs that draw on with the narration,
 * an optional "only if" note that dims the conditional steps, and an optional code strip synced to the steps.
 */
export const lifelines = defineTreatment({
	id: 'exchange.lifelines',
	need: 'exchange',
	name: 'Sequence diagram',
	when: 'A protocol or handshake with 2-4 parties and 2-5 ordered messages; best when the order of calls is the point.',
	params: {
		eyebrow: 'label', title: 'label', tag: 'label (e.g. the spec name)', tagAt: 'time',
		parties: '[{ id, icon, title, sub, tone }]  (2-4, left to right)',
		steps: '[{ from, to, request, requestSub, mono, reply, replyTone, at, replyAt, badgeAt }]  (2-5)',
		skip: '{ at, note, from: stepNumber (default 2), alt: { step, text } }  (optional: later steps are conditional)',
		code: '{ block: code(...), title, rows (default 3), steps: [{ at, from, to }] }  (optional)',
	},
	demo: () => ({
		eyebrow: label('The fix'), title: label('The client asks before it retries'), tag: label('RFC 6750'),
		parties: [{ id: 'app', icon: 'laptop', title: label('App'), sub: label('the client'), tone: 'blue' }, { id: 'api', icon: 'server', title: label('API'), sub: label('the resource') }, { id: 'auth', icon: 'key', title: label('Sign-in'), sub: label('the issuer') }],
		steps: [
			{ from: 'app', to: 'api', request: label('GET /items'), requestSub: label('with an old token'), reply: label('401'), replyTone: 'red' },
			{ from: 'app', to: 'auth', request: label('refresh the token'), reply: label('new token'), replyTone: 'green' },
			{ from: 'app', to: 'api', request: label('GET /items'), requestSub: label('with the new token'), reply: label('200 \u00b7 items'), replyTone: 'green' },
		],
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const parties = p.parties ?? [];
		need(parties.length >= 2 && parties.length <= 4, 'exchange.lifelines: 2-4 parties');
		const steps = p.steps ?? [];
		need(steps.length >= 1 && steps.length <= 5, 'exchange.lifelines: 1-5 steps');
		const xs = columnsX(parties.length, 280, 1640);
		const X = Object.fromEntries(parties.map((q, k) => [q.id, xs[k]]));
		for (const st of steps) {
			need(X[st.from] !== undefined && X[st.to] !== undefined, `step ${st.from} -> ${st.to}: unknown party`);
		}
		const hasCode = !!p.code;
		const areaTop = 352, areaEnd = hasCode ? 720 : 880;
		const rowH = Math.min(118, (areaEnd - areaTop) / steps.length);
		const laneW = Math.min(340, (1360 / Math.max(1, parties.length - 1)) - 40);
		const svg = svgLayer(root);
		const lanes = parties.map((q, k) => {
			const c = card(root, { left: xs[k] - laneW / 2, top: 226, width: laneW, height: 80, display: 'flex', alignItems: 'center', padding: '0 22px' });
			cardHead(c, { iconName: q.icon, title: q.title, sub: q.sub, tone: q.tone ?? 'neutral', size: parties.length > 3 ? 's' : 'm' });
			const line = el('div', 'st-abs', root, { left: xs[k] - 1, top: 306, width: 2, height: areaTop + steps.length * rowH - 306 + 10, backgroundImage: `linear-gradient(${C.lineStrong} 55%, transparent 0)`, backgroundSize: '2px 12px', transformOrigin: '50% 0' });
			return { c, line };
		});
		const leftX = Math.min(...xs);
		const nodes = steps.map((st, k) => {
			const y = areaTop + k * rowH;
			const x1 = X[st.from], x2 = X[st.to];
			const dir = Math.sign(x2 - x1) || 1;
			const req = arrow(svg, x1 + dir * 4, y, x2 - dir * 6, y, { color: C.connectorStrong });
			const rep = st.reply ? arrow(svg, x2 - dir * 4, y + 40, x1 + dir * 6, y + 40, { color: TONE[st.replyTone ?? 'neutral'].fg }) : null;
			const b = badge(root, { n: k + 1, size: 38, style: { position: 'absolute', left: leftX - 74, top: y + 20 - 19 } });
			const lx = Math.min(x1, x2) + 22;
			const rl = el('div', 'st-abs', root, { left: lx, top: y - 34, display: 'flex', alignItems: 'baseline', gap: 10, whiteSpace: 'nowrap' });
			txt(rl, st.request, st.mono ? 'st-mono' : '', { fontSize: st.mono ? 19 : 21, fontWeight: 600, color: C.ink });
			if (st.requestSub) {
				txt(rl, st.requestSub, '', { fontSize: 18, color: C.body });
			}
			const pl = st.reply ? txt(root, st.reply, 'st-abs', { left: lx, top: y + 8, whiteSpace: 'nowrap', fontSize: 19, fontWeight: 600, color: TONE[st.replyTone ?? 'neutral'].fg }, 'div') : null;
			if (pl) {
				ctx.anchor(`reply${k + 1}`, pl);
			}
			ctx.anchor(`request${k + 1}`, rl);
			return { y, req, rep, b, rl, pl, span: [Math.min(x1, x2), Math.max(x1, x2)] };
		});
		const reqAt = spread(ctx, steps, { lead: 1.2, tail: 2 });
		const repAt = steps.map((st, k) => (st.replyAt !== undefined ? ctx.at(st.replyAt) : reqAt[k] + 0.7));
		const badgeAt = steps.map((st, k) => (st.badgeAt !== undefined ? ctx.at(st.badgeAt) : reqAt[k]));
		let skip = null;
		if (p.skip) {
			const from = (p.skip.from ?? 2) - 1;
			const y0 = nodes[from].y - 44, y1 = nodes.at(-1).y + 60;
			const veil = el('div', 'st-abs', root, { left: 86, right: 86, top: y0, height: y1 - y0, background: 'rgba(255,255,255,.78)', borderRadius: 16 });
			// Put the note in the first conditional step's row, in the widest stretch no arrow of that row crosses;
			// if it doesn't fit there, put it below the steps.
			const rowSpan = nodes[from].span;
			const marks = [...new Set([...xs, 96, 1824])].sort((a, b) => a - b);
			let best = null;
			for (let g = 0; g < marks.length - 1; g++) {
				const a = marks[g], b2 = marks[g + 1];
				if (!(rowSpan[0] < b2 - 1 && rowSpan[1] > a + 1) && (!best || b2 - a > best[1] - best[0])) {
					best = [a, b2];
				}
			}
			const note = el('div', 'st-abs', root, { display: 'flex', justifyContent: 'center' });
			const notePill = pill(note, { tone: 'green', iconName: 'check', text: p.skip.note ?? label('These steps only run if needed'), size: 'l' });
			const place = () => {
				if (best && notePill.offsetWidth <= best[1] - best[0] - 40) {
					Object.assign(note.style, { left: `${best[0] + 20}px`, width: `${best[1] - best[0] - 40}px`, top: `${nodes[from].y - 7}px` });
				} else {
					Object.assign(note.style, { left: '96px', width: '1728px', top: `${nodes.at(-1).y + 70}px` });
				}
			};
			place();
			let alt = null;
			if (p.skip.alt) {
				const n = nodes[(p.skip.alt.step ?? 1) - 1];
				const leftAlt = (n.pl ? n.pl.offsetLeft + n.pl.offsetWidth : n.span[0] + 22) + 64;
				alt = txt(root, p.skip.alt.text, 'st-abs', { left: leftAlt, top: n.y + 8, whiteSpace: 'nowrap', fontSize: 19, fontWeight: 600, color: C.green }, 'div');
			}
			skip = { veil, note, alt, at: ctx.at(p.skip.at, Math.max(0, ctx.beat.duration - 2.5)) };
		}
		let code = null;
		if (hasCode) {
			const block = ctx.code(p.code.block);
			const labelRow = codeLabel(root, { x: 96, y: 752, w: 1728, title: p.code.title, file: block.path });
			const csteps = (p.code.steps ?? [{ at: reqAt[0] - ctx.beat.start, from: block.startLine, to: Math.min(block.endLine, block.startLine + (p.code.rows ?? 3) - 1) }]).map(st => ({ ...st, at: ctx.at(st.at) }));
			const strip = codeStrip(root, block, { x: 96, y: 784, w: 1728, rows: p.code.rows ?? 3, steps: csteps, revealAt: csteps[0].at - 0.3 });
			code = { labelRow, strip, at: csteps[0].at - 0.3 };
		}
		return { h, lanes, nodes, reqAt, repAt, badgeAt, skip, code };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		i.lanes.forEach((l, k) => {
			enter(l.c, t, s + 0.45 + k * 0.12, { dy: 12 });
			l.line.style.transform = `scaleY(${decel(prog(t, s + 0.8 + k * 0.12, s + 1.6 + k * 0.12))})`;
		});
		const skipAt = i.skip?.at ?? Infinity;
		i.nodes.forEach((n, k) => {
			n.req.render(t, i.reqAt[k], 0.55);
			enter(n.rl, t, i.reqAt[k] + 0.05, { dy: 6 });
			enter(n.b, t, i.badgeAt[k] - 0.1, { dy: 0, scale: 0.3, dur: 0.45 });
			if (n.rep) {
				n.rep.render(t, i.repAt[k], 0.55);
			}
			if (n.pl) {
				enter(n.pl, t, i.repAt[k] + 0.1, { dy: 6 });
			}
			// The current step is in full color; finished steps settle back until the summary.
			const nextAt = k < i.nodes.length - 1 ? i.reqAt[k + 1] : skipAt;
			const dim = t >= nextAt && t < skipAt ? 0.5 : 1;
			for (const node of [n.rl, n.pl].filter(Boolean)) {
				node.style.opacity = String(Number(node.style.opacity) * dim);
			}
		});
		if (i.skip) {
			const v = decel(prog(t, i.skip.at, i.skip.at + 0.5));
			i.skip.veil.style.opacity = String(v);
			i.skip.note.style.opacity = String(v);
			i.skip.note.style.transform = `translateY(${(1 - v) * 8}px)`;
			if (i.skip.alt) {
				enter(i.skip.alt, t, i.skip.at + 0.2, { dy: 6 });
			}
		}
		if (i.code) {
			enter(i.code.labelRow, t, i.code.at, { dy: 6 });
			i.code.strip.render(t);
		}
	},
});

/**
 * A packet travels between nodes laid out on one line; each hop draws an arc, the packet rides it,
 * and the hop's label appears. Reads as "what happens to one request", left to right.
 */
export const journey = defineTreatment({
	id: 'exchange.journey',
	need: 'exchange',
	name: 'Packet journey',
	when: 'One request or value moving through 3-5 places, where what happens at each stop matters more than strict call order.',
	params: {
		eyebrow: 'label', title: 'label',
		packet: '{ text, icon, tone }  (what travels)',
		nodes: '[{ id, icon, title, sub, tone }]  (3-5, left to right)',
		hops: '[{ from, to, label, result, resultTone, at }]  (each a curve between two nodes; result shows on the arrival node)',
	},
	demo: () => ({
		eyebrow: label('How it travels'), title: label('One request, three stops'),
		packet: { text: label('request'), icon: 'send' },
		nodes: [{ id: 'ui', icon: 'window', title: label('Editor'), tone: 'blue' }, { id: 'ext', icon: 'extension', title: label('Extension host') }, { id: 'srv', icon: 'server', title: label('Language server'), tone: 'purple' }],
		hops: [{ from: 'ui', to: 'ext', label: label('over IPC') }, { from: 'ext', to: 'srv', label: label('LSP request'), result: label('answers in 40 ms'), resultTone: 'green' }, { from: 'srv', to: 'ui', label: label('result shown') }],
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const nodes = p.nodes ?? [];
		need(nodes.length >= 2 && nodes.length <= 5, 'exchange.journey: 2-5 nodes');
		const hops = p.hops ?? [];
		need(hops.length >= 1 && hops.length <= 6, 'exchange.journey: 1-6 hops');
		const xs = columnsX(nodes.length, 260, 1660);
		const X = Object.fromEntries(nodes.map((n, k) => [n.id, xs[k]]));
		const Y = 560;
		const svg = svgLayer(root);
		const base = connector(svg, [[xs[0], Y], [xs.at(-1), Y]], { color: C.line, width: 2, head: false, radius: 0 });
		const nodeEls = nodes.map((n, k) => {
			const wrap = el('div', 'st-abs', root, { left: xs[k] - 130, width: 260, top: Y - 52, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 14 });
			iconTile(wrap, n.icon ?? 'box', { tone: n.tone ?? 'neutral', size: 104, round: true, iconSize: 48 });
			txt(wrap, n.title, 'st-h4', { fontSize: 25, textAlign: 'center', whiteSpace: 'nowrap' }, 'div');
			if (n.sub) {
				txt(wrap, n.sub, 'st-small', { fontSize: 18, textAlign: 'center', marginTop: -8, whiteSpace: 'nowrap' }, 'div');
			}
			const result = el('div', 'st-abs', root, { left: xs[k] - 160, width: 320, top: Y + 128, display: 'flex', justifyContent: 'center' });
			return { wrap, result, x: xs[k] };
		});
		const results = new Map();
		const hopEls = hops.map((hp, k) => {
			need(X[hp.from] !== undefined && X[hp.to] !== undefined, `hop ${hp.from} -> ${hp.to}: unknown node`);
			const x1 = X[hp.from], x2 = X[hp.to];
			// Forward hops arc above the nodes; hops going back arc below their labels and results.
			const back = x2 < x1;
			const yy = back ? Y + 196 : Y - 74;
			const lift = back ? Y + 300 : Y - 230 - (Math.abs(x2 - x1) > 800 ? 30 : 0);
			const pts = [[x1, yy], [x1, (yy + lift) / 2], [x1 + (x2 - x1) * 0.15, lift], [x2 - (x2 - x1) * 0.15, lift], [x2, (yy + lift) / 2], [x2, yy + (back ? 8 : -8)]];
			const arc = connector(svg, pts, { color: back ? C.connector : C.connectorStrong, radius: 60 });
			const lbl = txt(root, hp.label, 'st-abs', { left: Math.min(x1, x2) + 60, width: Math.abs(x2 - x1) - 120, top: lift + (back ? 12 : -40), textAlign: 'center', fontSize: 20, fontWeight: 600, color: C.body, whiteSpace: 'nowrap' }, 'div');
			if (hp.result) {
				const target = nodeEls[nodes.findIndex(n => n.id === hp.to)];
				const r = pill(target.result, { tone: hp.resultTone ?? 'neutral', text: hp.result, size: 's' });
				results.set(k, r);
			}
			return { arc, lbl };
		});
		const packet = el('div', 'st-carry', root);
		pill(packet, { tone: p.packet?.tone ?? 'blue', iconName: p.packet?.icon ?? 'send', text: p.packet?.text ?? label('request'), solid: true, size: 'm', style: { boxShadow: '0 8px 24px rgba(0, 95, 184, .22)' } });
		return { h, base, nodeEls, hopEls, results, packet, times: spread(ctx, hops, { lead: 1.4, tail: 1.6 }) };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		i.base.render(t, s + 0.4, 0.9);
		i.nodeEls.forEach((n, k) => enter(n.wrap, t, s + 0.5 + k * 0.15, { dy: 14 }));
		let active = -1;
		i.hopEls.forEach((hp, k) => {
			const at = i.times[k];
			hp.arc.render(t, at, 0.8);
			enter(hp.lbl, t, at + 0.2, { dy: 6 });
			if (t >= at) {
				active = k;
			}
			const r = i.results.get(k);
			if (r) {
				enter(r, t, at + 0.85, { dy: 0, scale: 0.3, dur: 0.45 });
			}
		});
		if (active < 0) {
			i.packet.style.opacity = '0';
			return;
		}
		const hp = i.hopEls[active];
		const p = standard(prog(t, i.times[active], i.times[active] + 0.8));
		const pt = hp.arc.pointAt(p);
		const w = i.packet.offsetWidth, hh = i.packet.offsetHeight;
		i.packet.style.transform = `translate(${pt.x - w / 2}px, ${pt.y - hh / 2}px)`;
		i.packet.style.opacity = String(clamp(prog(t, i.times[0] - 0.05, i.times[0] + 0.2)));
	},
});


==> catalog/flow.js  text 7912
// need: flow. Steps in order: a pipeline, a process, a branch.
import { defineTreatment } from '../engine/scene.js';
import { C, STEP, TONE } from '../theme/tokens.js';
import { badge, card, cardHead, connector, el, iconTile, svgLayer, tile, txt } from '../theme/primitives.js';
import { enter, prog, standard } from '../engine/motion.js';
import { label } from '../engine/text.js';
import { header, need, spread } from './kit.js';

/**
 * Stages left to right; each lights up when the narration reaches it, finished ones turn green.
 * One stage may branch down to an alternative outcome.
 */
export const pipeline = defineTreatment({
	id: 'flow.pipeline',
	need: 'flow',
	name: 'Pipeline',
	when: '2-5 steps that run in order (a build, a request path, a migration), optionally with one branch.',
	params: {
		eyebrow: 'label', title: 'label',
		stages: '[{ icon, title, sub, code, tone, at }]  (2-5)',
		branch: '{ from: stage number, label, title, sub, tone, icon, at }  (optional)',
	},
	demo: () => ({
		eyebrow: label('The fix'), title: label('Every save now goes through one queue'),
		stages: [{ icon: 'edit', title: label('Edit'), sub: label('user types') }, { icon: 'tasks', title: label('Queue'), sub: label('one write at a time') }, { icon: 'save', title: label('Write'), sub: label('to disk') }, { icon: 'check', title: label('Done'), sub: label('editor clean') }],
		branch: { from: 3, label: label('if the disk is full'), title: label('Retry later'), icon: 'warning', tone: 'orange' },
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const stages = p.stages ?? [];
		need(stages.length >= 2 && stages.length <= 5, 'flow.pipeline: 2-5 stages');
		const gap = 76, w = (1728 - gap * (stages.length - 1)) / stages.length;
		const top = p.branch ? 300 : 380, height = 250;
		const svg = svgLayer(root);
		const cards = stages.map((s, k) => {
			const x = 96 + k * (w + gap);
			const c = card(root, { left: x, top, width: w, height, padding: '28px 26px' });
			const row = el('div', '', c, { display: 'flex', alignItems: 'center', justifyContent: 'space-between' });
			const b = badge(row, { n: k + 1, size: 40, color: C.faint });
			iconTile(row, s.icon ?? 'box', { tone: s.tone ?? 'blue', size: 50 });
			txt(c, s.title, 'st-h3', { display: 'block', marginTop: 36, fontSize: stages.length > 4 ? 25 : 29, whiteSpace: 'nowrap' }, 'div');
			if (s.sub) {
				txt(c, s.sub, 'st-small', { display: 'block', marginTop: 6, fontSize: 19 }, 'div');
			}
			if (s.code) {
				const box = el('div', '', c, { position: 'absolute', left: 26, right: 26, bottom: 22, height: 40, borderRadius: 10, background: C.surface, display: 'flex', alignItems: 'center', padding: '0 14px', overflow: 'hidden' });
				box.dataset.box = 'tile';
				txt(box, s.code, 'st-mono', { fontSize: 16, color: C.ink, whiteSpace: 'nowrap' });
			}
			const arrow = k < stages.length - 1 ? connector(svg, [[x + w + 10, top + height / 2], [x + w + gap - 12, top + height / 2]], { color: C.connectorStrong, radius: 0 }) : null;
			return { c, b, arrow, x };
		});
		const times = spread(ctx, stages, { lead: 0.9, tail: p.branch ? 3 : 1.5 });
		let branch = null;
		if (p.branch) {
			const from = cards[(p.branch.from ?? stages.length) - 1];
			need(from, 'branch.from: no such stage');
			const cx = from.x + w / 2;
			const bw = Math.max(w, 380);
			const bx = Math.min(1824 - bw, Math.max(96, cx - bw / 2));
			const tone = p.branch.tone ?? 'orange';
			const line = connector(svg, [[cx, top + height + 10], [cx, 690]], { color: TONE[tone].fg, radius: 0 });
			const lab = txt(root, p.branch.label, 'st-abs', { left: cx + 18, top: top + height + 34, fontSize: 19, fontWeight: 600, color: TONE[tone].fg, whiteSpace: 'nowrap' }, 'div');
			const end = tile(root, tone, { left: bx, top: 704, width: bw, height: 120, display: 'flex', alignItems: 'center', padding: '0 28px' });
			cardHead(end, { iconName: p.branch.icon ?? 'warning', title: p.branch.title, sub: p.branch.sub, tone });
			branch = { line, lab, end, at: ctx.at(p.branch.at, Math.max(1, ctx.beat.duration - 2.6)) };
		}
		return { h, cards, times, branch };
	},
	render(i, t) {
		i.h.render(t);
		i.cards.forEach((c, k) => {
			const at = i.times[k];
			enter(c.c, t, at - 0.35, { dy: 16 });
			const on = standard(prog(t, at, at + 0.4));
			const done = k < i.cards.length - 1 ? standard(prog(t, i.times[k + 1], i.times[k + 1] + 0.4)) : 0;
			c.c.style.borderColor = on > 0.5 && done < 0.5 ? C.blue : C.line;
			c.c.style.boxShadow = on > 0.5 && done < 0.5 ? '0 10px 30px rgba(0, 95, 184, .12)' : 'none';
			c.b.style.background = done > 0.5 ? C.green : on > 0.5 ? C.blue : C.faint;
			if (c.arrow) {
				c.arrow.render(t, i.times[k + 1] - 0.45, 0.45);
			}
		});
		if (i.branch) {
			i.branch.line.render(t, i.branch.at, 0.5);
			enter(i.branch.lab, t, i.branch.at + 0.2, { dx: -8, dy: 0 });
			enter(i.branch.end, t, i.branch.at + 0.45, { dy: 12 });
		}
	},
});

/** A vertical list of numbered steps on a rail that fills as the narration moves down. */
export const numbered = defineTreatment({
	id: 'flow.numbered',
	need: 'flow',
	name: 'Numbered steps',
	when: '3-6 steps with a sentence each, where reading order matters more than a picture of the flow.',
	params: { eyebrow: 'label', title: 'label', steps: '[{ title, text, code, at }]  (2-6)' },
	demo: () => ({
		eyebrow: label('How it works'), title: label('Four steps on startup'),
		steps: [{ title: label('Read the settings'), text: label('once, when the window opens') }, { title: label('Find the cache'), text: label('in the user data folder'), code: label('cache.json') }, { title: label('Compare versions'), text: label('skip the cache if the format changed') }, { title: label('Load'), text: label('everything else is lazy') }],
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const steps = p.steps ?? [];
		need(steps.length >= 2 && steps.length <= 6, 'flow.numbered: 2-6 steps');
		const top = 256, rowH = Math.min(124, 640 / steps.length);
		const rail = el('div', 'st-abs', root, { left: 141, top: top + 24, width: 4, height: (steps.length - 1) * rowH, borderRadius: 2, background: C.track });
		const fill = el('div', '', rail, { width: 4, height: '100%', borderRadius: 2, background: C.blue, transformOrigin: '50% 0', transform: 'scaleY(0)' });
		const rows = steps.map((s, k) => {
			const y = top + k * rowH;
			const dot = badge(root, { n: k + 1, size: 48, color: C.faint, style: { position: 'absolute', left: 119, top: y } });
			const col = el('div', 'st-abs', root, { left: 204, top: y - 2, width: s.code ? 1060 : 1560 });
			txt(col, s.title, 'st-h3', { display: 'block', fontSize: 30, whiteSpace: 'nowrap' }, 'div');
			if (s.text) {
				txt(col, s.text, 'st-small', { display: 'block', fontSize: 21, marginTop: 4, whiteSpace: 'nowrap' }, 'div');
			}
			let code = null;
			if (s.code) {
				code = el('div', 'st-abs', root, { left: 1300, width: 524, top: y + 2, height: 48, borderRadius: 10, background: C.surface, display: 'flex', alignItems: 'center', padding: '0 18px', overflow: 'hidden' });
				code.dataset.box = 'tile';
				txt(code, s.code, 'st-mono', { fontSize: 18, color: C.ink, whiteSpace: 'nowrap' });
			}
			return { dot, col, code };
		});
		return { h, rail, fill, rows, times: spread(ctx, steps, { lead: 0.8, tail: 1.2 }) };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		enter(i.rail, t, s + 0.4, { dy: 0 });
		let reached = 0;
		i.rows.forEach((r, k) => {
			const at = i.times[k];
			enter(r.dot, t, at - 0.15, { dy: 0, scale: 0.4, dur: 0.4 });
			enter(r.col, t, at, { dx: -12, dy: 0 });
			if (r.code) {
				enter(r.code, t, at + 0.25, { dx: 12, dy: 0 });
			}
			r.dot.style.background = t >= at ? STEP[0] : C.faint;
			if (k > 0) {
				reached = Math.max(reached, (k - 1 + standard(prog(t, at - 0.5, at))) / Math.max(1, i.rows.length - 1));
			}
		});
		i.fill.style.transform = `scaleY(${reached})`;
	},
});

