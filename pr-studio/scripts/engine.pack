// prs smoke: a short video of a made-up PR, made end to end (voice, prepare, lint, render, encode, captions,
// sync gate) with timings. It checks a machine (a laptop, CI, the cloud agent) and never touches the gallery.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { ROOT, buildDir, videoDir, writeJson } from './common.mjs';
import { DEMO_DIFF, DEMO_SOURCE, demoFacts } from './catalog.mjs';

const SLUG = '_smoke';

const STORYBOARD = {
	pr: { repo: 'contoso/example', number: 1234 },
	length: { seconds: [20, 45], words: [50, 110] },
	pronounce: { '1234': 'twelve thirty-four', octocat: 'octo cat' },
	beats: [
		{
			id: 'title', need: 'title',
			say: 'Pull request {{facts.number}}, by {{facts.authorLogin}}: cache the settings, and refresh them when the file changes. {{facts.additions}} lines in {{facts.changedFiles}} files.',
			cues: { author: 'by', stats: '{{facts.additions}}', state: '{{facts.changedFiles}}' }, claims: [],
		},
		{
			id: 'change', need: 'code',
			say: 'The key change is one condition. The cached value is returned only while the file is not stale, and the cache now remembers when the file last changed.',
			cues: { guard: 'not stale', version: 'remembers' }, claims: [],
		},
		{
			id: 'read', need: 'flow',
			say: 'So every read takes the same path: look in the cache, check the time stamp, and parse the file again only when it changed.',
			cues: { cache: 'look in the cache', stamp: 'time stamp', parse: 'parse the file' }, claims: [],
		},
		{
			id: 'status', need: 'status',
			say: 'Unit tests cover the cache. To review it, start with the guard in the get method.',
			cues: { tests: 'Unit tests', start: 'start with' }, claims: [],
		},
	],
};

const SCENES = `// The smoke test's video (prs smoke): a made-up PR, written by hand.
import { defineVideo } from '../../engine/scene.js';
import { label, code } from '../../engine/text.js';
import { code as codeT, flow, status, title } from '../../catalog/index.js';

export default defineVideo({
	motion: 'slides',
	beats: {
		title: title.frame({ headline: label('Cache Settings, Refresh on Change') }),
		change: codeT.diff({
			eyebrow: label('The change'), title: label('Return the cached value only while it is fresh'),
			hunk: code('demo/src/cache.ts', { diff: true, anchor: 'isStale' }),
			callouts: [{ line: 5, text: label('skip a stale value'), tone: 'green', at: 'guard' }, { line: 10, text: label('remember when the file changed'), tone: 'blue', at: 'version' }],
		}),
		read: flow.pipeline({
			eyebrow: label('Every read'), title: label('One path, and parsing only when needed'),
			stages: [{ icon: 'search', title: label('Look in the cache'), sub: label('the value in memory'), at: 'cache' }, { icon: 'clock', title: label('Check the time stamp'), sub: label('has the file changed?'), at: 'stamp' }, { icon: 'documentText', title: label('Parse again'), sub: label('only when it changed'), at: 'parse' }],
		}),
		status: status.checklist({
			eyebrow: label('Before you review'), title: label('Tested, and where to start'),
			items: [{ icon: 'beaker', tone: 'green', title: label('Unit tests'), sub: label('for the cache'), at: 'tests' }, { icon: 'checkmark', tone: 'blue', title: label('One file changes behavior'), sub: label('the rest is tests and wiring') }],
			read: { label: label('Start here'), refs: [{ code: code('demo/src/cache.ts', { anchor: 'isStale' }), title: label('The guard'), what: label('where a stale value is skipped'), at: 'start' }] },
		}),
	},
});
`;

/** Make the smoke video from scratch; returns { ok, mp4, seconds }. */
export async function smoke({ provider } = {}) {
	const vdir = videoDir(SLUG), bdir = buildDir(SLUG);
	fs.rmSync(vdir, { recursive: true, force: true });
	const facts = demoFacts();
	fs.mkdirSync(path.join(bdir, 'src', facts.headSha9, 'demo', 'src'), { recursive: true });
	fs.writeFileSync(path.join(bdir, 'src', facts.headSha9, 'demo', 'src', 'cache.ts'), DEMO_SOURCE);
	fs.writeFileSync(path.join(vdir, 'pr.diff'), DEMO_DIFF);
	writeJson(path.join(vdir, 'pr.json'), { facts, body: 'Caches settings in memory and refreshes them when the file changes.', symbols: [], tests: [], tier: { name: 'small', seconds: [20, 45], words: [50, 110], beats: 4, reasons: [] } });
	writeJson(path.join(vdir, 'storyboard.json'), STORYBOARD);
	fs.writeFileSync(path.join(vdir, 'scenes.js'), SCENES);

	const seconds = {};
	const step = async (name, fn) => {
		const t0 = performance.now();
		try {
			return await fn();
		} finally {
			seconds[name] = (performance.now() - t0) / 1000;
		}
	};
	const { voice } = await import('./voice.mjs');
	const { prepare } = await import('./prepare.mjs');
	const { lint } = await import('./lint.mjs');
	const { render } = await import('./render.mjs');
	const { encodeChecked } = await import('./publish.mjs');
	const timeline = await step('voice', () => voice(SLUG, { provider }));
	await step('prepare', () => prepare(SLUG, { quiet: true }));
	const lintOk = await step('lint', () => lint(SLUG));
	await step('render', () => render(SLUG, {}));
	const { out, seconds: checked } = await encodeChecked(SLUG);
	Object.assign(seconds, checked);

	const { launch } = await import('./browser.mjs');
	const { contactSheet, keyTimes } = await import('./stills.mjs');
	const { readJson } = await import('./common.mjs');
	const project = readJson(path.join(bdir, 'project.json'));
	const frames = path.join(bdir, 'frames');
	const images = keyTimes(project).map(k => ({ file: path.join(frames, `${String(Math.round(k.t * 30)).padStart(5, '0')}.png`), label: `${k.t.toFixed(1)} s \u00b7 ${k.why}` })).filter(x => fs.existsSync(x.file));
	const browser = await launch();
	try {
		await contactSheet(browser, frames, images, path.join(bdir, 'contact.png'), { cols: 4, width: 480 });
	} finally {
		await browser.close();
	}
	const total = Object.values(seconds).reduce((a, b) => a + b, 0);
	const report = {
		ok: lintOk, mp4: path.relative(ROOT, out), videoSeconds: +project.video.total.toFixed(1), voice: timeline?.voice ?? null,
		machine: { platform: process.platform, arch: process.arch, cpus: os.cpus().length, memoryGb: +(os.totalmem() / 2 ** 30).toFixed(1), node: process.version },
		seconds: Object.fromEntries(Object.entries(seconds).map(([k, v]) => [k, +v.toFixed(1)])), total: +total.toFixed(1),
	};
	writeJson(path.join(bdir, 'smoke.json'), report);
	console.log(`\nsmoke: a ${report.videoSeconds} s video in ${report.total} s on ${report.machine.platform} (${report.machine.cpus} cores, voice: ${report.voice?.provider ?? '?'})`);
	for (const [k, v] of Object.entries(report.seconds)) {
		console.log(`  ${k.padEnd(8)} ${String(v).padStart(6)} s`);
	}
	console.log(`  ${lintOk ? 'lint clean' : 'LINT FOUND PROBLEMS (above)'} \u00b7 ${report.mp4} \u00b7 ${path.relative(ROOT, path.join(bdir, 'contact.png'))}`);
	return { ok: lintOk, mp4: out, seconds: report.seconds };
}

==> cli/lib/stills.mjs  text 4211
// prs stills: key frames of every beat (at its start, each cue and its end) plus a contact sheet.
import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { launch, openVideo } from './browser.mjs';
import { buildDir, readJson } from './common.mjs';

export function keyTimes(project) {
	const times = new Map();
	const add = (t, why) => {
		const key = +t.toFixed(2);
		if (key >= 0 && key < project.video.total && !times.has(key)) {
			times.set(key, why);
		}
	};
	project.beats.forEach((b, k) => {
		add(k === 0 ? 0 : b.start + 0.6, `${b.id} start`);
		// Just after the cue, but never past the beat's own last moment (into the fade to the next beat or the end card).
		for (const [name, at] of Object.entries(b.cues)) {
			add(Math.min(at + 0.9, b.end - 0.15), `${b.id} \u00b7 ${name}`);
		}
		add(b.end - 0.15, `${b.id} end`);
	});
	add(project.video.endAt + 1.6, 'end card');
	return [...times.entries()].sort((a, b) => a[0] - b[0]).map(([t, why]) => ({ t, why }));
}

/** Writes an HTML grid of images with labels and screenshots it. */
export async function contactSheet(browser, dir, images, out, { cols = 3, width = 640 } = {}) {
	const height = Math.round(width * 9 / 16);
	const cells = images.map(im => `<figure><img src="${pathToFileURL(im.file).href}" width="${width}" height="${height}"><figcaption>${im.label.replace(/</g, '&lt;')}</figcaption></figure>`).join('');
	const html = `<!doctype html><meta charset="utf-8"><style>body{margin:0;background:#e9ecf1;font:600 15px -apple-system,Segoe UI,sans-serif;color:#1b1b1f}main{display:grid;grid-template-columns:repeat(${cols},${width}px);gap:14px;padding:14px}figure{margin:0;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08)}img{display:block}figcaption{padding:7px 10px}</style><main>${cells}</main>`;
	const file = path.join(dir, '.contact.html');
	fs.writeFileSync(file, html);
	const page = await browser.newPage({ viewport: { width: cols * (width + 14) + 14, height: 400 }, deviceScaleFactor: 1 });
	await page.goto(pathToFileURL(file).href);
	await page.screenshot({ path: out, fullPage: true });
	await page.close();
	fs.rmSync(file);
}

export async function stills(slug, { at = null, beat = null, ends = false, scale = 1 } = {}) {
	const bdir = buildDir(slug);
	const project = readJson(path.join(bdir, 'project.json'));
	// --ends: one frame per beat at its fullest moment, half a second before it ends (for a review at full size).
	if (ends) {
		at = project.beats.map(b => +(b.end - 0.5).toFixed(2));
	}
	// A beat or a few times go into their own folder, so the full contact sheet (the one a reviewer reads) stays whole.
	const dir = at || beat ? path.join(bdir, 'stills', beat ? `beat-${beat}` : 'at') : path.join(bdir, 'stills');
	if (at || beat) {
		fs.rmSync(dir, { recursive: true, force: true });
	} else {
		for (const f of fs.existsSync(dir) ? fs.readdirSync(dir) : []) {
			if (f.endsWith('.png') || f.startsWith('.')) {
				fs.rmSync(path.join(dir, f), { force: true });
			}
		}
	}
	fs.mkdirSync(dir, { recursive: true });
	let list = at ? at.map((t, k) => ({ t, why: ends ? `${project.beats[k].id} end` : `t=${t}` })) : keyTimes(project);
	if (beat) {
		const b = project.beats.find(x => x.id === beat);
		if (!b) {
			throw new Error(`No beat "${beat}"`);
		}
		list = list.filter(x => x.t >= b.start - 0.4 && x.t <= b.end + 0.4);
	}
	const browser = await launch();
	try {
		const workers = Math.min(4, list.length);
		let next = 0;
		const images = [];
		await Promise.all(Array.from({ length: workers }, async () => {
			const v = await openVideo(browser, bdir, { scale });
			while (next < list.length) {
				const item = list[next++];
				await v.renderAt(item.t);
				const file = path.join(dir, `t${item.t.toFixed(2).padStart(6, '0')}.png`);
				await v.page.screenshot({ path: file });
				images.push({ file, label: `${item.t.toFixed(2)} s \u00b7 ${item.why}`, t: item.t });
			}
			await v.page.close();
		}));
		images.sort((a, b) => a.t - b.t);
		const sheet = path.join(dir, 'contact.png');
		await contactSheet(browser, dir, images, sheet);
		return { dir, images, sheet };
	} finally {
		await browser.close();
	}
}

==> cli/lib/timeline.mjs  text 3985
// Narration text helpers shared by prs check, the provisional timeline and prepare.
// They mirror voice/voice.py so cues resolve the same way before and after the real voice exists.
import { getPath, formatFact } from '../../engine/text.js';

const PLACEHOLDER = /\{\{([^{}]+)\}\}/g;
export const normalizeToken = s => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');

/** {{facts.additions}} or {{facts.additions|n}} -> value from pr.json facts. */
export function resolvePlaceholders(text, facts) {
	return text.replace(PLACEHOLDER, (_, expr) => {
		const [p, fmt] = expr.trim().split('|');
		const parts = p.trim().split('.');
		if (parts[0] !== 'facts' || parts.length < 2) {
			throw new Error(`Invalid placeholder {{${expr}}}: use {{facts.<path>}}`);
		}
		const value = getPath(facts, parts.slice(1).join('.'));
		if (value === undefined) {
			throw new Error(`Placeholder {{${expr}}} is not in pr.json facts`);
		}
		return fmt === 'n' ? formatFact(value, 'n') : String(value);
	});
}

/** Display tokens of a beat's narration (what the captions show). */
export function displayTokens(say, facts) {
	return resolvePlaceholders(say, facts).split(/\s+/).filter(Boolean);
}

/** Index of the nth occurrence of a phrase among the tokens; throws with the beat's words when missing. */
export function findPhrase(tokens, phrase, nth = 0) {
	const want = String(phrase).split(/\s+/).map(normalizeToken).filter(Boolean);
	if (!want.length) {
		throw new Error(`Cue phrase "${phrase}" has no words`);
	}
	const hay = tokens.map((t, i) => [i, normalizeToken(t)]).filter(([, t]) => t);
	const hits = [];
	for (let s = 0; s + want.length <= hay.length; s++) {
		if (want.every((w, k) => hay[s + k][1] === w)) {
			hits.push(hay[s][0]);
		}
	}
	if (nth >= hits.length) {
		throw new Error(`Cue phrase "${phrase}" (occurrence ${nth}) is not in: ${tokens.join(' ')}`);
	}
	return hits[nth];
}

export function cueSpec(value, facts) {
	if (typeof value === 'string') {
		return { phrase: resolvePlaceholders(value, facts), nth: 0, offset: 0 };
	}
	if (value && typeof value.phrase === 'string') {
		return { phrase: resolvePlaceholders(value.phrase, facts), nth: value.nth ?? 0, offset: value.offset ?? 0 };
	}
	throw new Error(`Cue must be a phrase or { phrase, nth, offset }: ${JSON.stringify(value)}`);
}

/**
 * A provisional timeline from word lengths, so visuals can be built before the voice exists.
 * Same shape as build/timeline.json; replaced by the real one once `prs voice` finishes.
 * `pace` speeds up the words and their pauses as voice.pace does the takes; the gaps between beats stay.
 */
export function estimateTimeline(storyboard, facts, { leadIn = 0.6, gap = 0.35, tail = 2.5, pace = 1 } = {}) {
	let t = leadIn;
	const beats = storyboard.beats.map((beat, k) => {
		if (k) {
			t += beat.gapBefore ?? gap;
		}
		const tokens = displayTokens(beat.say, facts);
		const start = t;
		const words = tokens.map((display, i) => {
			const core = normalizeToken(display);
			const dur = (0.13 + 0.052 * Math.max(2, core.length) + (/\d/.test(core) ? 0.12 * core.length : 0)) / pace;
			const a = t;
			t += dur;
			const b = t;
			if (/[.!?;:]["')\u201d]*$/.test(display)) {
				t += 0.32 / pace;
			} else if (/,["')\u201d]*$/.test(display)) {
				t += 0.16 / pace;
			}
			return { i, display, spoken: display, a: +a.toFixed(3), b: +b.toFixed(3) };
		});
		const end = words.at(-1).b;
		const cues = {};
		for (const [name, value] of Object.entries(beat.cues ?? {})) {
			const spec = cueSpec(value, facts);
			cues[name] = +(words[findPhrase(tokens, spec.phrase, spec.nth)].a + spec.offset).toFixed(3);
		}
		return { id: beat.id, start: +start.toFixed(3), end: +end.toFixed(3), text: tokens.join(' '), words, cues };
	});
	return { total: +(t + tail).toFixed(3), estimated: true, beats };
}

/** Rough spoken length of a storyboard, for the length window check. */
export function estimateSeconds(storyboard, facts) {
	return estimateTimeline(storyboard, facts).total;
}

==> cli/lib/voice.mjs  text 3934
// prs voice: narration audio + word timing for the storyboard (runs voice/voice.py in the pr-studio venv).
import fs from 'node:fs';
import path from 'node:path';
import { spawn, execFileSync } from 'node:child_process';
import { CAP, ROOT, buildDir, findFfmpeg, isOffline, loadConfig, readJson, storyboardVoiceHash, venvPython, videoDir, voiceEnv, writeJson } from './common.mjs';
import { estimateTimeline, resolvePlaceholders } from './timeline.mjs';

function writeScript(slug, storyboard, facts) {
	const dir = path.join(videoDir(slug), 'recording');
	fs.mkdirSync(dir, { recursive: true });
	const lines = ['# Script to record', '', 'Read each beat as written. Either one file per beat (recording/<beat id>.wav or .m4a),', 'or the whole script in one take as recording/full.wav (pause a second between beats).', ''];
	for (const b of storyboard.beats) {
		lines.push(`## ${b.id}`, '', resolvePlaceholders(b.say, facts), '');
	}
	fs.writeFileSync(path.join(dir, 'SCRIPT.md'), lines.join('\n'));
	return dir;
}

export async function voice(slug, { provider, force = false, redo } = {}) {
	const vdir = videoDir(slug), bdir = buildDir(slug);
	fs.mkdirSync(bdir, { recursive: true });
	const storyboard = readJson(path.join(vdir, 'storyboard.json'));
	const facts = readJson(path.join(vdir, 'pr.json')).facts;
	let chosen = provider ?? loadConfig().voice.provider;
	if (isOffline() && (!chosen || chosen === 'auto')) {
		chosen = 'kokoro'; // MAI-Voice-2 needs Azure
	}
	if (chosen === 'recording') {
		const dir = writeScript(slug, storyboard, facts);
		const has = fs.existsSync(dir) && fs.readdirSync(dir).some(f => /\.(wav|m4a|mp3|aiff?|flac|ogg)$/i.test(f));
		if (!has) {
			console.log(`Record the script in ${path.join(dir, 'SCRIPT.md')}, save the audio in ${dir}, then run prs voice --provider recording again.`);
			return null;
		}
	}
	if (chosen === 'silent') {
		// Captions only: provisional timing at reading pace, and a silent track so the encoder has audio.
		const timeline = estimateTimeline(storyboard, facts, { leadIn: 0.6, gap: 0.6, tail: 2.5 });
		timeline.voice = { provider: 'silent', name: 'none' };
		delete timeline.estimated;
		writeJson(path.join(bdir, 'timeline.json'), timeline);
		execFileSync(findFfmpeg(), ['-v', 'error', '-y', '-f', 'lavfi', '-i', 'anullsrc=r=48000:cl=mono', '-t', String(timeline.total), '-c:a', 'pcm_s16le', path.join(bdir, 'narration.wav')]);
		writeJson(path.join(bdir, 'voice.json'), { provider: 'silent', voice: 'none', storyboard: storyboardVoiceHash(storyboard), at: new Date().toISOString() });
		console.log(`silent narration: ${timeline.total.toFixed(1)} s of captions at reading pace`);
		return timeline;
	}
	const py = venvPython();
	const args = [path.join(ROOT, 'voice', 'voice.py'), 'synth', '--video', vdir, ...(chosen && chosen !== 'auto' ? ['--provider', chosen] : []), ...(force ? ['--force'] : []), ...(redo ? ['--redo', String(redo)] : [])];
	await new Promise((resolve, reject) => {
		const child = spawn(py, args, { stdio: ['ignore', 'inherit', 'inherit'], env: voiceEnv() });
		child.on('error', reject);
		child.on('close', code => (code === 0 ? resolve() : reject(new Error(`voice.py exited with ${code}`))));
	});
	const timeline = readJson(path.join(bdir, 'timeline.json'));
	writeJson(path.join(bdir, 'voice.json'), { provider: timeline.voice.provider, voice: timeline.voice.name, storyboard: storyboardVoiceHash(storyboard), at: new Date().toISOString() });
	// The narration's length is where its last word ends: what the cap counts (the file adds the end card).
	const seconds = Math.max(0, ...timeline.beats.flatMap(b => b.words.map(w => w.b)));
	const note = seconds > CAP.seconds ? `: past the ${CAP.seconds} s cap (${CAP.fileSeconds} s with the end card), cut the narration and voice it again` : `, within the ${CAP.seconds} s cap`;
	console.log(`narration ready: the last word ends at ${seconds.toFixed(1)} s${note}`);
	return timeline;
}

