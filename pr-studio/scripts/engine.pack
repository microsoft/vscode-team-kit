// need: state. States and transitions: a lifecycle, a status that moves.
import { defineTreatment } from '../engine/scene.js';
import { C, TONE } from '../theme/tokens.js';
import { connector, el, icon, pill, svgLayer, txt } from '../theme/primitives.js';
import { clamp, enter, lerp, prog, standard } from '../engine/motion.js';
import { label } from '../engine/text.js';
import { columnsX, header, need, spread } from './kit.js';

/** States on a track; a marker moves from state to state as the narration describes each transition. */
export const track = defineTreatment({
	id: 'state.track',
	need: 'state',
	name: 'State track',
	when: 'Something moves through 3-5 states (signed out -> negotiating -> authorized; queued -> running -> done), maybe with a failure state.',
	params: {
		eyebrow: 'label', title: 'label',
		states: '[{ title, sub (about 30 characters: one line), icon, tone, at }]  (3-5, in order)',
		edges: '[{ label }]  (labels of the transitions between consecutive states; optional)',
		marker: '{ text, icon }  (what moves)',
		fail: '{ from: state number, title, sub, tone (red by default; neutral for an end that is not a failure), icon, at }  (optional dead end below a state)',
	},
	demo: () => ({
		eyebrow: label('The lifecycle'), title: label('A download now retries before it fails'),
		states: [{ title: label('Queued'), icon: 'hourglass' }, { title: label('Downloading'), icon: 'download' }, { title: label('Retrying'), icon: 'repeat', tone: 'orange' }, { title: label('Installed'), icon: 'check', tone: 'green' }],
		edges: [{ label: label('start') }, { label: label('network error') }, { label: label('second try works') }],
		marker: { text: label('extension.vsix'), icon: 'box' },
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const states = p.states ?? [];
		need(states.length >= 2 && states.length <= 5, 'state.track: 2-5 states');
		const xs = columnsX(states.length, 260, 1660);
		const Y = p.fail ? 520 : 580;
		const svg = svgLayer(root);
		const base = connector(svg, [[xs[0], Y], [xs.at(-1), Y]], { color: C.track, width: 8, head: false, radius: 0 });
		const prog2 = connector(svg, [[xs[0], Y], [xs.at(-1), Y]], { color: C.blue, width: 8, head: false, radius: 0 });
		const nodes = states.map((s, k) => {
			const tone = s.tone ?? 'blue';
			const dot = el('div', 'st-abs', root, { left: xs[k] - 46, top: Y - 46, width: 92, height: 92, borderRadius: 46, background: '#fff', border: `4px solid ${C.lineStrong}`, display: 'grid', placeItems: 'center' });
			const ic = icon(dot, s.icon ?? 'status', 40, C.faint);
			const lab = el('div', 'st-abs', root, { left: xs[k] - 170, width: 340, top: Y + 70, textAlign: 'center' });
			txt(lab, s.title, 'st-h4', { display: 'block', fontSize: 27, whiteSpace: 'nowrap' }, 'div');
			if (s.sub) {
				txt(lab, s.sub, 'st-small', { display: 'block', fontSize: 19, marginTop: 4 }, 'div');
			}
			return { dot, ic, lab, tone };
		});
		const edges = (p.edges ?? []).slice(0, states.length - 1).map((e, k) => (e?.label ? txt(root, e.label, 'st-abs', { left: xs[k] + 50, width: xs[k + 1] - xs[k] - 100, top: Y - 92, textAlign: 'center', fontSize: 20, fontWeight: 600, color: C.body, whiteSpace: 'nowrap' }, 'div') : null));
		const marker = el('div', 'st-carry', root);
		pill(marker, { tone: 'blue', iconName: p.marker?.icon ?? 'box', text: p.marker?.text ?? label('item'), solid: true, size: 'm', style: { boxShadow: '0 8px 22px rgba(0, 95, 184, .22)' } });
		const times = spread(ctx, states, { lead: 0.8, tail: p.fail ? 3 : 1.4 });
		let fail = null;
		if (p.fail) {
			const k = (p.fail.from ?? 2) - 1;
			need(nodes[k], 'fail.from: no such state');
			const tone = p.fail.tone ?? 'red';
			const line = connector(svg, [[xs[k], Y + 160], [xs[k], Y + 214]], { color: TONE[tone]?.fg ?? C.red, width: 3, radius: 0 });
			const box = el('div', 'st-abs', root, { left: Math.max(96, xs[k] - 210), width: 420, top: Y + 224, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 8 });
			pill(box, { tone, iconName: p.fail.icon ?? (tone === 'red' ? 'dismiss' : 'info'), text: p.fail.title, size: 'l' });
			if (p.fail.sub) {
				txt(box, p.fail.sub, 'st-small', { display: 'block', fontSize: 19, textAlign: 'center' }, 'div');
			}
			fail = { line, box, at: ctx.at(p.fail.at, Math.max(1, ctx.beat.duration - 2.4)) };
		}
		return { h, xs, Y, base, prog2, nodes, edges, marker, times, fail };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		i.base.render(t, s + 0.4, 0.8);
		let k = -1;
		i.nodes.forEach((n, j) => {
			enter(n.dot, t, s + 0.5 + j * 0.12, { dy: 0, scale: 0.4, dur: 0.5 });
			enter(n.lab, t, s + 0.6 + j * 0.12, { dy: 8 });
			if (t >= i.times[j]) {
				k = j;
			}
		});
		i.edges.forEach((e, j) => {
			if (e) {
				enter(e, t, i.times[j + 1] - 0.4, { dy: 6 });
			}
		});
		i.nodes.forEach((n, j) => {
			const on = j <= k;
			n.dot.style.borderColor = on ? TONE[n.tone].fg : C.lineStrong;
			n.dot.style.background = j === k ? TONE[n.tone].tint : '#fff';
			n.ic.style.color = on ? TONE[n.tone].fg : C.faint;
		});
		// Progress line and marker follow the current state.
		const seg = k < 0 ? 0 : k;
		const from = i.xs[Math.max(0, seg - 1)], to = i.xs[seg];
		const p = k <= 0 ? 1 : standard(prog(t, i.times[k] - 0.45, i.times[k] + 0.25));
		const x = k < 0 ? i.xs[0] : lerp(from, to, p);
		const span = i.xs.at(-1) - i.xs[0];
		i.prog2.path.style.strokeDasharray = `${span}`;
		i.prog2.path.style.strokeDashoffset = `${span - (x - i.xs[0])}`;
		const w = i.marker.offsetWidth, hh = i.marker.offsetHeight;
		i.marker.style.transform = `translate(${x - w / 2}px, ${i.Y - 150 - hh / 2 - 18 * Math.sin(Math.PI * p) * (k > 0 ? 1 : 0)}px)`;
		i.marker.style.opacity = String(clamp(prog(t, i.times[0] - 0.3, i.times[0])));
		if (i.fail) {
			i.fail.line.render(t, i.fail.at, 0.35);
			enter(i.fail.box, t, i.fail.at + 0.25, { dy: 10 });
		}
	},
});

==> catalog/status.js  text 8403
// need: status. Scope, tests and what is still open; where a reviewer should start reading.
import { defineTreatment } from '../engine/scene.js';
import { C, TONE } from '../theme/tokens.js';
import { el, iconTile, tile, txt, badge, card } from '../theme/primitives.js';

const STEP_TONES = ['blue', 'purple', 'green', 'orange', 'neutral'];
import { decel, enter, lerp, prog, standard } from '../engine/motion.js';
import { label, path as pathText } from '../engine/text.js';
import { header, need, spread } from './kit.js';

function readRefs(parent, read, ctx, { width }) {
	txt(parent, read.label ?? label('Start reading here'), 'st-label', { display: 'block', color: C.blue }, 'div');
	const refs = read.refs ?? [];
	need(refs.length >= 1 && refs.length <= 3, 'read.refs: 1-3');
	return refs.map((r, k) => {
		const block = ctx.code(r.code);
		const row = el('div', '', parent, { marginTop: k ? 44 : 32, display: 'flex', gap: 22, alignItems: 'flex-start' });
		const dot = badge(row, { n: k + 1, size: 46, color: C.faint });
		const col = el('div', '', row, { minWidth: 0, maxWidth: width - 120 });
		txt(col, r.title, 'st-mono', { display: 'block', fontSize: 26, fontWeight: 600, color: C.ink, whiteSpace: 'nowrap' }, 'div');
		if (r.what) {
			txt(col, r.what, '', { display: 'block', marginTop: 6, fontSize: 21, color: C.body, whiteSpace: 'nowrap' }, 'div');
		}
		const loc = txt(col, [pathText(block.path), label(`:${block.startLine}`)], 'st-mono', { display: 'block', marginTop: 12, fontSize: 17, color: C.body, whiteSpace: 'nowrap' }, 'div');
		loc.lastChild.dataset.src = 'code';
		txt(col, pathText(block.path, { show: 'dir' }), 'st-foot', { display: 'block', marginTop: 4, fontSize: 16, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }, 'div');
		return { row, dot, col, at: r.at };
	});
}

/** A reviewer's checklist (scope, follow-ups, tests, what's pending) and where to start reading. */
export const checklist = defineTreatment({
	id: 'status.checklist',
	need: 'status',
	name: 'Checklist + start here',
	when: 'The closing beat: what is in scope, what is left for later, how it is tested, and the 1-3 places to read first.',
	params: {
		eyebrow: 'label', title: 'label',
		items: '[{ icon, tone, title, sub, at }]  (2-5)',
		read: '{ label, refs: [{ code: code(file, { anchor }), title, what, at }] }  (optional, 1-3; without at, the refs light up from a third of the way into the beat)',
	},
	demo: () => ({
		eyebrow: label('Scope and status'), title: label('What to know before reviewing'),
		items: [{ icon: 'shield', tone: 'blue', title: label('Windows only'), sub: label('macOS follows in a separate PR') }, { icon: 'beaker', tone: 'green', title: label('Unit tests included'), sub: label('three new cases') }, { icon: 'person', tone: 'orange', title: label('Manual test pending'), sub: label('per the author') }],
	}),
	mount(root, p, ctx) {
		const wrapH = header(root, p, ctx);
		const items = p.items ?? [];
		need(items.length >= 2 && items.length <= 5, 'status.checklist: 2-5 items');
		const hasRead = !!p.read;
		const width = hasRead ? 900 : 1728;
		const rowH = Math.min(118, 660 / items.length);
		const rows = items.map((it, k) => {
			const row = el('div', 'st-abs', root, { left: 96, top: 248 + k * rowH, width, height: rowH - 14, display: 'flex', alignItems: 'center', gap: 26 });
			iconTile(row, it.icon ?? 'checkmark', { tone: it.tone ?? STEP_TONES[k % STEP_TONES.length], size: 64, round: true });
			const col = el('div', '', row, { minWidth: 0 });
			txt(col, it.title, 'st-h3', { display: 'block', fontSize: 30, whiteSpace: 'nowrap' }, 'div');
			if (it.sub) {
				txt(col, it.sub, 'st-small', { display: 'block', fontSize: 21, marginTop: 2, whiteSpace: 'nowrap' }, 'div');
			}
			const line = k < items.length - 1 ? el('div', 'st-abs', root, { left: 96 + 90, top: 248 + k * rowH + rowH - 7, width: width - 90, height: 1.5, background: C.line, transformOrigin: '0 50%' }) : null;
			return { row, line };
		});
		const itemAt = spread(ctx, items, { lead: 0.3, tail: hasRead ? ctx.beat.duration * 0.6 : 1.5 });
		let read = null;
		if (hasRead) {
			const box = tile(root, 'neutral', { left: 1080, top: 248, width: 744, height: 452, padding: '32px 36px' });
			const refs = readRefs(box, p.read, ctx, { width: 744 - 72 });
			// Where to start reading is often said only on screen, in a short closing beat: it comes forward early and stays.
			const refAt = spread(ctx, refs, { lead: ctx.beat.duration * 0.33, tail: ctx.beat.duration * 0.25 });
			read = { box, refs, refAt };
		}
		return { h: wrapH, rows, itemAt, read };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		// The whole list is there from the start (dimmed); each item comes forward when the narration reaches it.
		i.rows.forEach((r, k) => {
			const shown = enter(r.row, t, s + 0.25 + k * 0.08, { dy: 0, dx: -14 });
			const on = standard(prog(t, i.itemAt[k] - 0.1, i.itemAt[k] + 0.3));
			r.row.style.opacity = String(shown * lerp(0.35, 1, on));
			if (r.line) {
				r.line.style.opacity = '1';
				r.line.style.transform = `scaleX(${decel(prog(t, s + 0.45 + k * 0.08, s + 1.05 + k * 0.08))})`;
			}
		});
		if (i.read) {
			enter(i.read.box, t, s + 0.7, { dy: 16 });
			i.read.refs.forEach((r, k) => {
				const on = standard(prog(t, i.read.refAt[k] - 0.1, i.read.refAt[k] + 0.3));
				r.col.style.opacity = String(lerp(0.38, 1, on));
				r.dot.style.background = on > 0.5 ? C.blue : C.faint;
			});
		}
	},
});

/** Now / next / later: what this PR does, what follows, what is still open. */
export const board = defineTreatment({
	id: 'status.board',
	need: 'status',
	name: 'Now, next, later',
	when: 'The closing beat when the PR is one step of a larger plan: what lands now, what follows, what is open. Text only: for places to start reading (code references), use status.checklist.',
	params: { eyebrow: 'label', title: 'label', columns: '[{ title, tone, icon, items: [{ text, sub, at }] }]  (2-3 columns, 1-4 items each)' },
	demo: () => ({
		eyebrow: label('Status'), title: label('Where this leaves us'),
		columns: [{ title: label('In this PR'), tone: 'green', icon: 'check', items: [{ text: label('Entra ID sign-in') }, { text: label('Unit tests') }] }, { title: label('Follow-up'), tone: 'blue', icon: 'arrowRight', items: [{ text: label('GitHub sign-in') }] }, { title: label('Open'), tone: 'orange', icon: 'hourglass', items: [{ text: label('Manual test on a real server') }] }],
	}),
	mount(root, p, ctx) {
		const h = header(root, p, ctx);
		const cols = p.columns ?? [];
		need(cols.length >= 2 && cols.length <= 3, 'status.board: 2-3 columns');
		const gap = 28, w = (1728 - gap * (cols.length - 1)) / cols.length;
		const colEls = cols.map((c, k) => {
			const tone = c.tone ?? ['green', 'blue', 'orange'][k];
			const x = 96 + k * (w + gap);
			const head = el('div', 'st-abs', root, { left: x, top: 252, width: w, display: 'flex', alignItems: 'center', gap: 14 });
			iconTile(head, c.icon ?? 'checkmark', { tone, size: 50, round: true, solid: true });
			txt(head, c.title, '', { fontSize: 30, fontWeight: 600, color: C.ink, whiteSpace: 'nowrap' });
			const rule = el('div', 'st-abs', root, { left: x, top: 324, width: w, height: 4, borderRadius: 2, background: TONE[tone].fg, transformOrigin: '0 50%' });
			const items = c.items ?? [];
			need(items.length >= 1 && items.length <= 4, `column ${k + 1}: 1-4 items`);
			const cards = items.map((it, j) => {
				const cardEl = card(root, { left: x, top: 352 + j * 132, width: w, height: 114, padding: '22px 26px' });
				txt(cardEl, it.text, '', { display: 'block', fontSize: 25, fontWeight: 600, color: C.ink, lineHeight: 1.25 }, 'div');
				if (it.sub) {
					txt(cardEl, it.sub, 'st-small', { display: 'block', marginTop: 6, fontSize: 19 }, 'div');
				}
				return { cardEl, at: it.at };
			});
			return { head, rule, cards };
		});
		const all = colEls.flatMap(c => c.cards);
		return { h, colEls, all, times: spread(ctx, all, { lead: 0.8, tail: 1.2 }) };
	},
	render(i, t, ctx) {
		const s = ctx.beat.start;
		i.h.render(t);
		let n = 0;
		i.colEls.forEach((c, k) => {
			const first = i.times[n];
			enter(c.head, t, Math.min(first - 0.3, s + 0.4 + k * 0.4), { dy: 10 });
			c.rule.style.transform = `scaleX(${decel(prog(t, first - 0.2, first + 0.5))})`;
			c.cards.forEach(card => {
				enter(card.cardEl, t, i.times[n++], { dy: 14 });
			});
		});
	},
});


==> catalog/title.js  text 10646
// The fixed first beat. Frame 0 is the thumbnail: the title is composed from the start; the
// "What changes" card slides in at the stats cue, or early in the beat when the narration doesn't say the numbers.
import { defineTreatment } from '../engine/scene.js';
import { C } from '../theme/tokens.js';
import { card, el, fit, microsoftLogo, pill, txt } from '../theme/primitives.js';
import { count, decel, enter, fmt, lerp, prog } from '../engine/motion.js';
import { fact, label } from '../engine/text.js';

/** Text computed by this template from PR facts (not authored), stamped as such for the linter. */
function factText(parent, text, factPath, cls, style, tag) {
	const node = txt(parent, label(text), cls, style, tag);
	node.dataset.src = `fact:${factPath}`;
	return node;
}

function fileRows(files, areas, budget) {
	// Areas by size; files by size inside an area. Rows: area head 40, file 30, gap 14; "more" rows 30.
	const order = [...areas].sort((a, b) => (b.additions + b.deletions) - (a.additions + a.deletions));
	const groups = [];
	let used = 0, hiddenFiles = 0, hiddenAreas = 0;
	for (const area of order) {
		const inArea = files.filter(f => f.area === area.name).sort((a, b) => (b.additions + b.deletions) - (a.additions + a.deletions));
		const head = 40 + (groups.length ? 14 : 0);
		const fitsAll = used + head + inArea.length * 30 <= budget;
		const room = fitsAll ? inArea.length : Math.floor((budget - used - head - 30) / 30);
		if (room < 1) {
			hiddenFiles += inArea.length;
			hiddenAreas++;
			continue;
		}
		const shown = fitsAll ? inArea : inArea.slice(0, room);
		const more = inArea.length - shown.length;
		groups.push({ area, shown, more });
		used += (groups.length > 1 ? 14 : 0) + 40 + shown.length * 30 + (more ? 30 : 0);
	}
	return { groups, hiddenFiles, hiddenAreas };
}

export const frame = defineTreatment({
	id: 'title.frame',
	need: 'title',
	name: 'Title frame',
	when: 'Always the first beat. Fixed design: PR number, your short headline, the PR title, author, state, and a per-file "What changes" card.',
	params: {
		headline: 'label: what the PR does in 4-8 plain words (not the PR title)',
		at: '{ author, stats, state }: times; default to the cues of the same names',
	},
	demo: () => ({ headline: label('Show build status in the window title') }),
	mount(root, p, ctx) {
		const F = ctx.facts;
		const logo = microsoftLogo(root, 96, 82, 32);
		const eyebrow = txt(root, [label('Pull request #'), fact('number'), label('  \u00b7  '), fact('repo')], 'st-eyebrow st-abs', { left: 96, top: 300 }, 'div');
		const title = txt(root, p.headline ?? fact('title'), 'st-title-xl st-abs', { left: 96, top: 342, width: 880 }, 'div');
		const sub = txt(root, [label('\u201c'), fact('title'), label('\u201d')], 'st-sub st-abs', { left: 96, top: 540, width: 820, fontSize: 26 }, 'div');
		const by = el('div', 'st-abs', root, { left: 96, top: 660, display: 'flex', alignItems: 'center', gap: 16, whiteSpace: 'nowrap' });
		factText(by, F.authorLogin[0].toUpperCase(), 'authorLogin', '', { width: 46, height: 46, borderRadius: 23, background: C.blueTint, color: C.blue, display: 'grid', placeItems: 'center', fontSize: 22, fontWeight: 700 }, 'div');
		txt(by, fact('authorLogin', { prefix: '@' }), '', { fontSize: 26, fontWeight: 600, color: C.ink });
		txt(by, [label('opened '), fact('createdAt', { format: 'date' })], '', { fontSize: 23, color: C.body });
		const pills = el('div', 'st-abs', root, { left: 96, top: 744, display: 'flex', gap: 12 });
		const stateTone = { OPEN: 'green', MERGED: 'purple', CLOSED: 'red' }[F.state] ?? 'neutral';
		const p1 = pill(pills, { tone: F.isDraft ? 'neutral' : stateTone, text: F.isDraft ? label('Draft') : fact('state', { format: 'state' }) });
		const p2 = F.reviewDecision ? pill(pills, { tone: F.reviewDecision === 'APPROVED' ? 'green' : F.reviewDecision === 'CHANGES_REQUESTED' ? 'red' : 'orange', text: fact('reviewDecision', { format: 'review' }) }) : null;

		// "What changes": totals + per-file diffstat grouped by area
		const cardEl = card(root, { left: 1040, top: 170, width: 784, height: 730 });
		txt(cardEl, label('What changes'), 'st-label st-abs', { left: 34, top: 30, color: C.blue }, 'div');
		const totals = el('div', 'st-abs', cardEl, { left: 34, top: 64, display: 'flex', alignItems: 'baseline', gap: 22, whiteSpace: 'nowrap' });
		const addN = txt(totals, fact('additions', { prefix: '+', format: 'n' }), 'st-num', { fontSize: 60, color: C.green });
		const delN = txt(totals, fact('deletions', { prefix: '\u2212', format: 'n' }), 'st-num', { fontSize: 60, color: C.red });
		const meta = txt(totals, [fact('changedFiles', { format: 'n' }), label(F.changedFiles === 1 ? ' file  \u00b7  ' : ' files  \u00b7  '), fact('commitCount'), label(F.commitCount === 1 ? ' commit' : ' commits')], '', { fontSize: 22, color: C.body });
		el('div', 'st-abs', cardEl, { left: 0, right: 0, top: 150, height: 1.5, background: C.line });
		const { groups, hiddenFiles, hiddenAreas } = fileRows(F.files, F.areas, 730 - 172 - 20);
		const maxChange = Math.max(1, ...F.files.map(f => f.additions + f.deletions));
		const BARW = 170;
		let y = 172;
		const bars = [];
		groups.forEach(({ area, shown, more }, gi) => {
			if (gi) {
				y += 14;
			}
			const head = el('div', 'st-abs', cardEl, { left: 34, right: 34, top: y, height: 40, display: 'flex', alignItems: 'center' });
			factText(head, area.name, 'areas', 'st-mono', { fontSize: 19, fontWeight: 600, color: C.ink, flex: 1, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', minWidth: 0 }, 'div');
			const sum = el('div', 'st-mono', head, { fontSize: 18, whiteSpace: 'nowrap', flex: 'none', marginLeft: 16 });
			factText(sum, `+${fmt(area.additions)}`, 'areas', '', { color: C.green });
			factText(sum, `\u2212${fmt(area.deletions)}`, 'areas', '', { color: C.red, marginLeft: 10 });
			y += 40;
			const base = f => f.path.split('/').pop();
			for (const f of shown) {
				const dup = shown.filter(g => base(g) === base(f)).length > 1;
				const name = dup ? f.path.split('/').slice(-2).join('/') : base(f);
				const row = el('div', 'st-abs', cardEl, { left: 34, right: 34, top: y, height: 30, display: 'flex', alignItems: 'center', gap: 14 });
				const nameNode = factText(row, name, 'files', 'st-mono', { fontSize: 16, color: f.isTest ? C.muted : C.body, width: 420, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', flex: 'none' }, 'div');
				nameNode.dataset.path = f.path;
				const track = el('div', '', row, { width: BARW, height: 10, flex: 'none', display: 'flex', borderRadius: 5, background: '#f0f2f5', overflow: 'hidden' });
				const g = el('div', '', track, { height: 10, width: 0, background: C.green });
				const r = el('div', '', track, { height: 10, width: 0, background: C.red });
				factText(row, `+${fmt(f.additions)} \u2212${fmt(f.deletions)}`, 'files', 'st-mono', { fontSize: 15, color: C.body, flex: 1, textAlign: 'right', whiteSpace: 'nowrap' }, 'div');
				bars.push({ g, r, ga: BARW * f.additions / maxChange, rd: BARW * f.deletions / maxChange, k: bars.length });
				y += 30;
			}
			if (more) {
				factText(cardEl, `+ ${more} more ${more === 1 ? 'file' : 'files'}`, 'files', 'st-abs', { left: 34, top: y, height: 30, lineHeight: '30px', fontSize: 16, color: C.muted, whiteSpace: 'nowrap' }, 'div');
				y += 30;
			}
		});
		if (hiddenFiles) {
			y += 10;
			factText(cardEl, `+ ${hiddenFiles} more ${hiddenFiles === 1 ? 'file' : 'files'} in ${hiddenAreas} more ${hiddenAreas === 1 ? 'area' : 'areas'}`, 'files', 'st-abs', { left: 34, top: y, height: 30, lineHeight: '30px', fontSize: 16, color: C.muted, whiteSpace: 'nowrap' }, 'div');
			y += 30;
		}
		cardEl.style.height = `${Math.min(730, y + 30)}px`;
		cardEl.style.top = `${Math.max(150, 170 + (730 - Math.min(730, y + 30)) / 2)}px`;
		const at = p.at ?? {};
		// A one-sentence title beat is short: the author, the numbers and the state come in sooner, so all are up before it ends.
		const scale = Math.min(1, ctx.beat.duration / 11);
		const quick = Math.max(0.3, Math.min(1, scale * 2));
		const stats = ctx.at(at.stats ?? (ctx.has('stats') ? 'stats' : undefined), 5 * scale);
		const stateRef = at.state ?? (ctx.has('state') ? 'state' : undefined);
		const times = {
			author: ctx.at(at.author ?? (ctx.has('author') ? 'author' : undefined), 2.4 * scale),
			stats,
			// Without a time of their own, the state pills come after the numbers have been said, not before.
			state: stateRef !== undefined ? ctx.at(stateRef) : Math.max(ctx.at(undefined, 8 * scale), stats + 1.5 * scale),
		};
		return {
			logo, eyebrow, title, sub, by, p1, p2, cardEl, addN, delN, meta, bars, times, quick,
			totals: { additions: F.additions, deletions: F.deletions },
			layout() {
				// Headline: at most two lines; the stack below follows it and stays inside the frame.
				let size = 78;
				while (title.offsetHeight > size * 1.08 * 2 + 4 && size > 52) {
					size -= 2;
					title.style.fontSize = `${size}px`;
				}
				fit(sub, { width: 820 * 3, min: 20 });
				const subTop = 342 + title.offsetHeight + 34;
				sub.style.top = `${subTop}px`;
				const byTop = subTop + sub.offsetHeight + 50;
				by.style.top = `${byTop}px`;
				pills.style.top = `${byTop + 84}px`;
				const bottom = byTop + 84 + 44;
				if (bottom > 900) {
					const shift = bottom - 900;
					for (const n of [eyebrow, title, sub, by, pills]) {
						n.style.top = `${parseFloat(n.style.top) - shift}px`;
					}
				}
			},
		};
	},
	render(i, t) {
		// In a short title beat everything moves quicker, so it is all in place before the beat ends.
		const k = i.quick;
		i.title.style.transform = `translateY(${lerp(6, 0, decel(prog(t, 0, 2.2 * k)))}px)`;
		enter(i.by, t, i.times.author, { dur: 0.6 * k });
		enter(i.cardEl, t, i.times.stats - 0.45 * k, { dx: 28, dy: 0, dur: 0.6 * k });
		const tot = decel(prog(t, i.times.stats - 0.15 * k, i.times.stats + 0.25 * k));
		i.addN.style.opacity = i.delN.style.opacity = String(tot);
		i.meta.style.opacity = String(decel(prog(t, i.times.stats + 0.6 * k, i.times.stats + 1.0 * k)));
		i.addN.textContent = `+${fmt(count(t, i.times.stats - 0.1 * k, 0.9 * k, i.totals.additions))}`;
		i.delN.textContent = `\u2212${fmt(count(t, i.times.stats - 0.1 * k, 0.9 * k, i.totals.deletions))}`;
		for (const b of i.bars) {
			const q = decel(prog(t, i.times.stats + (0.4 + b.k * 0.05) * k, i.times.stats + (1.2 + b.k * 0.05) * k));
			b.g.style.width = `${b.ga * q}px`;
			b.r.style.width = `${b.rd * q}px`;
		}
		enter(i.p1, t, i.times.state, { dy: 8, dur: 0.6 * k });
		if (i.p2) {
			enter(i.p2, t, i.times.state + 0.15 * k, { dy: 8, dur: 0.6 * k });
		}
	},
});

