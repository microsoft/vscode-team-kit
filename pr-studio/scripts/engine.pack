// prs lint: renders many frames and checks layout and text provenance; decodes the end card QR; checks novelty.
import fs from 'node:fs';
import path from 'node:path';
import { PNG } from 'pngjs';
import jsQR from 'jsqr';
import { launch, openVideo } from './browser.mjs';
import { buildDir, readJson } from './common.mjs';
import { noveltyProblems } from './history.mjs';

function sampleTimes(project, every) {
	const times = new Set();
	const add = t => {
		if (t >= 0 && t < project.video.total) {
			times.add(+t.toFixed(2));
		}
	};
	for (const b of project.beats) {
		for (let k = 1; k <= 12; k++) {
			add(b.start + ((b.end - b.start) * k) / 13);
		}
		for (const c of Object.values(b.cues)) {
			add(c + 0.7);
			add(c + 1.6);
		}
		add(b.end - 0.05);
	}
	for (const d of [0.4, 1, 2, 3]) {
		add(project.video.total - d);
	}
	add(0);
	if (every) {
		for (let t = 0; t < project.video.total; t += every) {
			add(t);
		}
	}
	return [...times].sort((a, b) => a - b);
}

/** Runs inside the page: returns layout and provenance problems of the current frame. */
function inspectFrame() {
	const opacityOf = el => {
		let o = 1;
		for (let e = el; e && e.nodeType === 1; e = e.parentElement) {
			const s = getComputedStyle(e);
			if (s.display === 'none' || s.visibility === 'hidden') {
				return 0;
			}
			o *= Number(s.opacity);
		}
		return o;
	};
	const texts = [];
	const walker = document.createTreeWalker(document.getElementById('app'), NodeFilter.SHOW_TEXT);
	const seen = new Map();
	for (let n = walker.nextNode(); n; n = walker.nextNode()) {
		if (!n.textContent.trim()) {
			continue;
		}
		const el = n.parentElement;
		const op = opacityOf(el);
		if (op < 0.35) {
			continue;
		}
		const range = document.createRange();
		range.selectNodeContents(n);
		let l = Infinity, t = Infinity, r = -Infinity, b = -Infinity;
		const lines = [];
		for (const rc of range.getClientRects()) {
			if (rc.width < 0.5) {
				continue;
			}
			lines.push({ l: rc.left, t: rc.top, r: rc.right, b: rc.bottom });
			l = Math.min(l, rc.left); t = Math.min(t, rc.top); r = Math.max(r, rc.right); b = Math.max(b, rc.bottom);
		}
		if (!isFinite(l)) {
			continue;
		}
		const entry = seen.get(el) ?? { el, rect: { l, t, r, b }, text: '', lines: [] };
		entry.lines.push(...lines);
		entry.rect = { l: Math.min(entry.rect.l, l), t: Math.min(entry.rect.t, t), r: Math.max(entry.rect.r, r), b: Math.max(entry.rect.b, b) };
		entry.text = (entry.text + n.textContent).slice(0, 80);
		seen.set(el, entry);
	}
	texts.push(...seen.values());
	const out = [];
	// While the camera flies between panels (canvas mode), text crossing the frame edge is expected.
	const moving = (window.__moving ?? 0) > 0.001;
	const R = x => [x.l, x.t, x.r, x.b].map(Math.round);
	for (const x of texts) {
		const { l, t, r, b } = x.rect;
		const inCode = !!x.el.closest('[data-box="code"]');
		const inCaptions = !!x.el.closest('.st-captions');
		if (!x.el.closest('[data-src]')) {
			out.push({ kind: 'no-provenance', text: x.text, rect: R(x.rect) });
		}
		if (!moving && (l < -0.5 || t < -0.5 || r > 1920.5 || b > 1080.5)) {
			out.push({ kind: 'offscreen', text: x.text, rect: R(x.rect) });
		}
		const box = x.el.closest('[data-box]');
		if (box && !inCaptions) {
			const br = box.getBoundingClientRect();
			const horiz = l < br.left + 1.5 || r > br.right - 1.5;
			const vert = !inCode && (t < br.top - 0.5 || b > br.bottom + 0.5);
			if (horiz || vert) {
				out.push({ kind: 'outside-box', text: x.text, rect: R(x.rect), box: [br.left, br.top, br.right, br.bottom].map(Math.round), boxKind: box.dataset.box });
			}
		}
		for (let e = x.el.parentElement; e && e.id !== 'app'; e = e.parentElement) {
			const s = getComputedStyle(e);
			if (s.overflowX === 'visible' && s.overflowY === 'visible') {
				continue;
			}
			const er = e.getBoundingClientRect();
			const clippedX = l < er.left - 0.5 || r > er.right + 0.5;
			const clippedY = !inCode && (t < er.top - 0.5 || b > er.bottom + 0.5);
			if (clippedX || clippedY) {
				// An ellipsis on purpose (text-overflow) is fine for secondary text like paths.
				if (getComputedStyle(x.el).textOverflow === 'ellipsis' && x.el.scrollWidth > x.el.clientWidth) {
					break;
				}
				out.push({ kind: 'clipped', text: x.text, rect: R(x.rect), by: e.className || e.tagName });
				break;
			}
		}
		if (!moving && !inCaptions && b > 935) {
			out.push({ kind: 'caption-band', text: x.text, rect: R(x.rect) });
		}
	}
	for (let a = 0; a < texts.length; a++) {
		for (let c = a + 1; c < texts.length; c++) {
			const A = texts[a], B = texts[c];
			if (A.el.contains(B.el) || B.el.contains(A.el)) {
				continue;
			}
			// The morph object takes off from and lands on its anchors: overlapping them is the point.
			if (A.el.closest('[data-flight]') || B.el.closest('[data-flight]')) {
				continue;
			}
			// Layers that are never both visible in the same place (a wipe's before/after) don't collide.
			const xa = A.el.closest('[data-exclusive]')?.dataset.exclusive, xb = B.el.closest('[data-exclusive]')?.dataset.exclusive;
			if (xa && xb && xa.split(':')[0] === xb.split(':')[0] && xa !== xb) {
				continue;
			}
			let worst = null;
			for (const a1 of A.lines) {
				for (const b1 of B.lines) {
					const w = Math.min(a1.r, b1.r) - Math.max(a1.l, b1.l);
					const h = Math.min(a1.b, b1.b) - Math.max(a1.t, b1.t);
					if (w > 2 && h > 2 && (!worst || w * h > worst[0] * worst[1])) {
						worst = [Math.round(w), Math.round(h)];
					}
				}
			}
			if (worst) {
				out.push({ kind: 'text-overlap', text: `${A.text}  \u00d7  ${B.text}`, rect: worst });
			}
		}
	}
	return out;
}

async function checkQr(v, project) {
	const at = project.video.endAt + 2;
	await v.renderAt(at);
	const rect = await v.page.evaluate(() => {
		const svg = document.querySelector('svg[data-qr]');
		if (!svg) {
			return null;
		}
		const r = svg.getBoundingClientRect();
		return { x: r.left - 20, y: r.top - 20, width: r.width + 40, height: r.height + 40, want: svg.dataset.qr };
	});
	if (!rect) {
		return 'no QR code on the end card';
	}
	const buf = await v.page.screenshot({ clip: { x: rect.x, y: rect.y, width: rect.width, height: rect.height } });
	const png = PNG.sync.read(buf);
	const code = jsQR(new Uint8ClampedArray(png.data), png.width, png.height);
	if (!code) {
		return 'the end card QR code does not decode';
	}
	return code.data === project.pr.facts.url ? null : `the QR code opens ${code.data}, not ${project.pr.facts.url}`;
}

export async function lint(slug, { every = 0 } = {}) {
	const bdir = buildDir(slug);
	const project = readJson(path.join(bdir, 'project.json'));
	const times = sampleTimes(project, every);
	const browser = await launch();
	const problems = [];
	let qr = null;
	let meta = null;
	try {
		const workers = 4;
		let next = 0;
		await Promise.all(Array.from({ length: workers }, async (_, w) => {
			const v = await openVideo(browser, bdir);
			while (next < times.length) {
				const t = times[next++];
				await v.renderAt(t);
				for (const p of await v.page.evaluate(inspectFrame)) {
					problems.push({ t, ...p });
				}
			}
			if (w === 0) {
				qr = await checkQr(v, project);
				meta = await v.meta();
			}
			await v.page.close();
		}));
	} finally {
		await browser.close();
	}
	const uniq = new Map();
	for (const p of problems.sort((a, b) => a.t - b.t)) {
		const key = `${p.kind}|${p.text}`;
		if (!uniq.has(key)) {
			uniq.set(key, { ...p, times: [p.t] });
		} else {
			uniq.get(key).times.push(p.t);
		}
	}
	const novelty = slug.startsWith('_') ? [] : noveltyProblems(slug, meta); // _catalog, _smoke: not real videos
	const late = meta?.late ?? [];
	const total = uniq.size + (qr ? 1 : 0) + novelty.length + late.length;
	console.log(`lint: ${times.length} frames checked, ${total} problem${total === 1 ? '' : 's'}`);
	for (const p of uniq.values()) {
		const { t, times: ts, kind, text, ...rest } = p;
		void t;
		const beat = project.beats.findLast(b => ts[0] >= b.start - 0.4)?.id ?? '?';
		console.log(`  ${kind.padEnd(14)} ${beat.padEnd(12)} at ${ts.slice(0, 3).map(x => `${x}s`).join(', ')}${ts.length > 3 ? ` (+${ts.length - 3})` : ''}  "${text}"  ${JSON.stringify(rest)}`);
	}
	if (qr) {
		console.log(`  qr             ${qr}`);
	}
	for (const n of novelty) {
		console.log(`  novelty        ${n}`);
	}
	for (const l of late) {
		console.log(`  late           ${l.beat.padEnd(12)} ${l.ref} is at ${l.at}s but the beat starts leaving at ${l.leaves}s: time it earlier`);
	}
	fs.writeFileSync(path.join(bdir, 'lint.json'), JSON.stringify({ frames: times.length, problems: [...uniq.values()], qr, novelty }, null, 1));
	return total === 0;
}

==> cli/lib/prepare.mjs  text 10202
// prs prepare: storyboard + timeline (real or provisional) + PR facts + scenes.js -> build/project.json + build/bundle.js
// Every text and code reference in scenes.js is verified against the PR here, before anything renders.
import fs from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import * as esbuild from 'esbuild';
import { ROOT, buildDir, readJson, sha256, sha256File, storyboardVoiceHash, videoDir, voicePace, writeJson } from './common.mjs';
import { estimateTimeline } from './timeline.mjs';
import { parseDiff, resolveCode, fileAtHead } from './code.mjs';
import { checkEvidence, stripMarkdown } from './evidence.mjs';
import { codeKey, getPath, walkRefs } from '../../engine/text.js';

const norm = s => String(s).replace(/\s+/g, ' ').trim();

/** Bundles scenes.js for Node and imports it (SVG icons load as text; no DOM is touched at import time). */
export async function loadScenes(slug, file = 'scenes.js') {
	const out = path.join(buildDir(slug), `.${path.basename(file, '.js')}.node.mjs`);
	await esbuild.build({
		entryPoints: [path.join(videoDir(slug), file)], bundle: true, platform: 'node', format: 'esm', outfile: out,
		loader: { '.svg': 'text', '.css': 'empty' }, logLevel: 'silent', absWorkingDir: ROOT,
	});
	const mod = await import(`${pathToFileURL(out).href}?v=${Date.now()}`);
	const video = mod.default;
	if (!video?.$video) {
		throw new Error(`${file} must "export default defineVideo({ ... })"`);
	}
	return { video, concepts: mod.concepts ?? null };
}

export function prCorpus(slug, pr) {
	const diff = fs.readFileSync(path.join(videoDir(slug), 'pr.diff'), 'utf8');
	const diffText = diff.split('\n').filter(l => /^[+\- ]/.test(l) && !/^(\+\+\+|---) /.test(l)).map(l => l.slice(1)).join('\n');
	const f = pr.facts;
	return {
		diff,
		quote: norm([f.title, pr.body ?? '', stripMarkdown(pr.body ?? ''), ...(f.commits ?? []).map(c => c.message ?? c.headline), diffText, ...(f.linkedIssues ?? []).map(i => i.title), ...(pr.tests ?? []).flatMap(t => t.names), ...(pr.discussion ?? []).flatMap(d => [d.body, stripMarkdown(d.body)])].join('\n')),
		idents: [diffText, f.files.map(x => x.path).join('\n'), pr.body ?? ''].join('\n'),
		paths: f.files.map(x => x.path),
	};
}

function verifyText(ref, corpus, facts, codeTexts) {
	if (/\bTODO\b/.test(ref.text ?? '')) {
		return { error: `still a TODO: "${ref.text}"` };
	}
	switch (ref.$text) {
		case 'label':
			return /\d{3,}/.test(ref.text) ? `label "${ref.text}" contains a number: if it comes from the PR, use fact() or quote()` : null;
		case 'fact':
			return getPath(facts, ref.path) === undefined ? `fact('${ref.path}') is not in pr.json facts` : false;
		case 'quote':
			return corpus.quote.includes(norm(ref.text)) ? false : `quote("${ref.text}") is not in the PR (title, body, commits, diff, tests or review discussion). Quote exactly or use label()`;
		case 'ident': {
			const bare = ref.text.replace(/\(\)$/, '').replace(/^[.#@]/, '');
			if (corpus.idents.includes(bare) || codeTexts.some(t => t.includes(bare)) || corpus.inChangedFiles(bare)) {
				return false;
			}
			return `ident("${ref.text}") is not in the PR's diff or its changed files at the head commit`;
		}
		case 'path': {
			const ok = corpus.paths.some(p => p === ref.path || p.includes(`${ref.path}/`) || p.endsWith(`/${ref.path}`) || p.includes(`/${ref.path}/`) || p.startsWith(`${ref.path}/`));
			return ok ? false : `path("${ref.path}") is not a file (or folder) changed by this PR`;
		}
		default:
			return `unknown text kind ${ref.$text}`;
	}
}

export async function prepare(slug, { quiet = false } = {}) {
	const vdir = videoDir(slug), bdir = buildDir(slug);
	fs.mkdirSync(bdir, { recursive: true });
	const pr = readJson(path.join(vdir, 'pr.json'));
	const storyboard = readJson(path.join(vdir, 'storyboard.json'));
	const facts = pr.facts;
	const real = fs.existsSync(path.join(bdir, 'timeline.json'));
	const timeline = real ? readJson(path.join(bdir, 'timeline.json')) : estimateTimeline(storyboard, facts, { pace: voicePace() });
	if (real) {
		const voiced = readJson(path.join(bdir, 'voice.json'));
		if (voiced.storyboard !== storyboardVoiceHash(storyboard)) {
			throw new Error('storyboard.json changed after the voice was made. Run: prs voice (or delete build/timeline.json to use provisional timing)');
		}
	}
	const { video, concepts } = await loadScenes(slug);
	const ids = storyboard.beats.map(b => b.id);
	const sceneIds = Object.keys(video.beats);
	const missing = ids.filter(id => !sceneIds.includes(id));
	const extra = sceneIds.filter(id => !ids.includes(id));
	if (missing.length || extra.length) {
		throw new Error(`scenes.js and storyboard.json disagree. ${missing.length ? `Missing in scenes.js: ${missing.join(', ')}. ` : ''}${extra.length ? `Not in the storyboard: ${extra.join(', ')}.` : ''}`);
	}
	if (video.beats[ids[0]].treatment !== 'title.frame') {
		throw new Error(`The first beat ("${ids[0]}") must use title.frame`);
	}

	// Collect and verify every reference.
	const corpus = prCorpus(slug, pr);
	// Names that aren't in the diff may still be in the changed files (a class whose method changed): look there last.
	let changedTexts = null;
	corpus.inChangedFiles = name => {
		changedTexts ??= facts.files.filter(f => f.status !== 'removed').map(f => {
			try {
				return fileAtHead(slug, facts, f.path);
			} catch {
				return '';
			}
		});
		return changedTexts.some(t => t.includes(name));
	};
	const diffFiles = parseDiff(corpus.diff);
	const problems = [], warnings = [];
	const codeRefs = new Map();
	const textRefs = [];
	const allSpecs = { ...video.beats };
	for (const [name, spec] of Object.entries(concepts?.options ?? {})) {
		allSpecs[`concept:${name}`] = spec;
	}
	for (const [id, spec] of Object.entries(allSpecs)) {
		for (const { ref, trail } of walkRefs(spec.params)) {
			if (ref.$code) {
				codeRefs.set(codeKey(ref), { ref, where: `${id}.${trail}` });
			} else {
				textRefs.push({ ref, where: `${id}.${trail}` });
			}
		}
	}
	if (video.carry) {
		for (const { ref, trail } of walkRefs(video.carry)) {
			textRefs.push({ ref, where: `carry.${trail}` });
		}
	}
	const code = {};
	for (const [key, { ref, where }] of codeRefs) {
		try {
			code[key] = await resolveCode(slug, facts, diffFiles, ref);
		} catch (error) {
			problems.push(`${where}: ${error.message}`);
		}
	}
	const codeTexts = Object.values(code).map(b => b.lines.map(l => l.text).join('\n'));
	for (const { ref, where } of textRefs) {
		const issue = verifyText(ref, corpus, facts, codeTexts);
		if (issue?.error) {
			problems.push(`${where}: ${issue.error}`);
		} else if (issue && ref.$text === 'label') {
			warnings.push(`${where}: ${issue}`);
		} else if (issue) {
			problems.push(`${where}: ${issue}`);
		}
	}
	// Every claim's evidence must hold against the PR.
	for (const beat of storyboard.beats) {
		for (const claim of beat.claims ?? []) {
			for (const ev of claim.evidence ?? []) {
				const issue = checkEvidence(slug, pr, ev);
				if (issue) {
					problems.push(`storyboard ${beat.id}: ${issue}`);
				}
			}
		}
	}
	if (problems.length) {
		throw new Error(`prepare found ${problems.length} problem${problems.length > 1 ? 's' : ''}:\n  - ${problems.join('\n  - ')}`);
	}

	// Timing of the whole video: the end card follows the last word; then a 3.4 s hold.
	const beats = storyboard.beats.map((sb, k) => {
		const tb = timeline.beats.find(b => b.id === sb.id);
		if (!tb) {
			throw new Error(`Beat "${sb.id}" is missing from the timeline; run prs voice`);
		}
		return { id: sb.id, need: sb.need, start: k === 0 ? 0 : tb.start, end: tb.end, words: tb.words, cues: tb.cues };
	});
	const lastWord = beats.at(-1).words.at(-1).b;
	const endAt = +(lastWord + 0.45).toFixed(3);
	const total = +Math.max(timeline.total, endAt + 3.4).toFixed(3);
	const project = {
		id: slug, estimated: !real,
		pr: { facts },
		video: { fps: 30, endAt, total, motion: video.motion },
		beats, code,
	};
	writeJson(path.join(bdir, 'project.json'), project);
	await bundle(slug);
	const lock = {
		project: sha256File(path.join(bdir, 'project.json')),
		bundle: sha256(fs.readFileSync(path.join(bdir, 'bundle.js')) + fs.readFileSync(path.join(bdir, 'bundle.css'))),
		timeline: real ? sha256File(path.join(bdir, 'timeline.json')) : null,
		narration: real && fs.existsSync(path.join(bdir, 'narration.wav')) ? sha256File(path.join(bdir, 'narration.wav')) : null,
	};
	writeJson(path.join(bdir, 'build.lock.json'), lock);
	if (!quiet) {
		console.log(`prepared ${slug}: ${beats.length} beats, ${total.toFixed(1)} s${real ? '' : ' (provisional timing: run prs voice for the real one)'}, ${Object.keys(code).length} code blocks, ${textRefs.length} text references verified`);
		for (const w of warnings) {
			console.log(`  warning: ${w}`);
		}
	}
	return { project, video, warnings, lock };
}

export async function bundle(slug, { entry = null } = {}) {
	const bdir = buildDir(slug);
	const entryFile = path.join(bdir, 'entry.js');
	const rel = p => path.relative(bdir, p).split(path.sep).join('/');
	fs.writeFileSync(entryFile, entry ?? [
		`import video, * as scenes from '${rel(path.join(videoDir(slug), 'scenes.js'))}';`,
		"import project from './project.json';",
		`import { start } from '${rel(path.join(ROOT, 'engine', 'runtime.js'))}';`,
		'const concept = new URLSearchParams(location.search).get(\'concept\');',
		'const chosen = concept && scenes.concepts ? { ...video, beats: { ...video.beats, [scenes.concepts.beat]: scenes.concepts.options[concept] } } : video;',
		'start(chosen, project).catch(error => console.error(error && error.stack || String(error)));',
		'',
	].join('\n'));
	await esbuild.build({
		entryPoints: { bundle: entryFile }, bundle: true, format: 'iife', platform: 'browser', outdir: bdir,
		loader: { '.svg': 'text', '.json': 'json', '.woff2': 'file' }, external: ['file:*'], assetNames: 'assets/[name]-[hash]',
		logLevel: 'silent', absWorkingDir: ROOT, target: 'chrome120',
	});
	fs.writeFileSync(path.join(bdir, 'index.html'), '<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><link rel="stylesheet" href="bundle.css"></head>\n<body><div id="app"></div><script src="bundle.js"></script></body></html>\n');
}

==> cli/lib/publish.mjs  text 7319
// prs publish: encode, subtitles, sync gate, deliver to ~/Downloads/pr-videos/<slug>/ (the mp4, and a WebM copy that VS
// Code's chat can play), record in the history (and, in the repository, in the gallery).
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { CAP, IN_REPO, ROOT, buildDir, loadConfig, readJson, sha256File, venvPython, videoDir, voiceEnv, writeJson } from './common.mjs';
import { encode, encodeWebm } from './encode.mjs';
import { addToHistory } from './history.mjs';
import { launch } from './browser.mjs';
import { contactSheet, keyTimes } from './stills.mjs';

function verifyLock(bdir) {
	const lock = readJson(path.join(bdir, 'build.lock.json'));
	const info = readJson(path.join(bdir, 'frames', 'render.json'));
	const project = readJson(path.join(bdir, 'project.json'));
	if (project.estimated) {
		throw new Error('The frames use provisional timing. Run prs voice, then prs render, before publishing.');
	}
	if (sha256File(path.join(bdir, 'project.json')) !== lock.project || info.project !== lock.project || info.bundle !== lock.bundle) {
		throw new Error('The frames are stale (rendered from another project or bundle). Run prs render.');
	}
	if (lock.timeline !== sha256File(path.join(bdir, 'timeline.json')) || lock.narration !== sha256File(path.join(bdir, 'narration.wav'))) {
		throw new Error('The narration or timeline changed after prepare. Run prs render again.');
	}
	return { project, info };
}

/** Encode the rendered frames, write the captions file and run the sync gate. Returns the mp4, srt and timings. */
export async function encodeChecked(slug, { skipSync = false } = {}) {
	const bdir = buildDir(slug);
	const { project } = verifyLock(bdir);
	const out = path.join(bdir, `${slug}.mp4`);
	const seconds = {};
	let t0 = performance.now();
	await encode(slug, { out });
	seconds.encode = (performance.now() - t0) / 1000;
	console.log(`encoded in ${seconds.encode.toFixed(1)} s`);
	const py = venvPython();
	const env = voiceEnv();
	const srt = path.join(bdir, `${slug}.srt`);
	spawnSync(py, [path.join(ROOT, 'voice', 'voice.py'), 'srt', path.join(bdir, 'timeline.json'), srt], { stdio: 'inherit', env });
	const voiceInfo = readJson(path.join(bdir, 'voice.json'));
	if (!skipSync && voiceInfo.provider !== 'silent') {
		t0 = performance.now();
		const sync = spawnSync(py, [path.join(ROOT, 'voice', 'voice.py'), 'check-sync', out, path.join(bdir, 'project.json')], { stdio: ['ignore', 'pipe', 'inherit'], env, encoding: 'utf8' });
		process.stdout.write(sync.stdout);
		seconds.sync = (performance.now() - t0) / 1000;
		if (sync.status !== 0) {
			throw new Error('SYNC GATE failed: the audio in the mp4 does not match the captions. Not delivered.');
		}
	}
	return { project, out, srt, voiceInfo, seconds };
}

export async function publish(slug, { skipSync = false } = {}) {
	const vdir = videoDir(slug), bdir = buildDir(slug);
	const planned = readJson(path.join(bdir, 'project.json'));
	if (planned.video.total > CAP.fileSeconds) {
		throw new Error(`The video runs ${planned.video.total.toFixed(1)} s, past the ${CAP.fileSeconds} s cap: cut the narration (its last word ends by ${CAP.seconds} s), then prs voice, prs render and prs publish again. Not delivered.`);
	}
	const { project, out, srt, voiceInfo } = await encodeChecked(slug, { skipSync });
	// Deliver.
	const dest = path.join(loadConfig().deliver, slug);
	const earlier = fs.existsSync(path.join(dest, `${slug}.mp4`)) ? fs.statSync(path.join(dest, `${slug}.mp4`)).mtime : null;
	fs.mkdirSync(dest, { recursive: true });
	fs.copyFileSync(out, path.join(dest, `${slug}.mp4`));
	fs.copyFileSync(srt, path.join(dest, `${slug}.srt`));
	// VS Code's chat plays this one: its window decodes WebM but no MP4.
	const webm = await encodeWebm(out, path.join(dest, `${slug}.webm`));
	// A contact sheet of the key frames, delivered next to the mp4.
	const frames = path.join(bdir, 'frames');
	const images = keyTimes(project).filter((_, i, a) => a.length <= 12 || i % Math.ceil(a.length / 12) === 0).map(k => ({ file: path.join(frames, `${String(Math.round(k.t * 30)).padStart(5, '0')}.png`), label: `${k.t.toFixed(1)} s \u00b7 ${k.why}` })).filter(x => fs.existsSync(x.file));
	const browser = await launch();
	try {
		await contactSheet(browser, frames, images, path.join(bdir, 'contact.png'), { cols: 4, width: 480 });
	} finally {
		await browser.close();
	}
	fs.copyFileSync(path.join(bdir, 'contact.png'), path.join(dest, 'contact.png'));
	if (IN_REPO) {
		await addToGallery(slug, { vdir, bdir, mp4: out });
	}
	const meta = project.beats.map(b => b.id);
	const { loadScenes } = await import('./prepare.mjs');
	const { video } = await loadScenes(slug);
	const { textOf, fact } = await import('../../engine/text.js');
	const headline = textOf(video.beats[meta[0]].params?.headline ?? fact('title'), project.pr.facts);
	const facts = project.pr.facts;
	addToHistory({
		slug, repo: facts.repo, number: facts.number, title: facts.title, headline, date: new Date().toISOString(),
		seconds: +project.video.total.toFixed(1), motion: video.motion, layout: video.layout,
		treatments: Object.fromEntries(meta.map(id => [id, video.beats[id].treatment])),
		voice: voiceInfo.provider,
	});
	// What a job needs to post the video (to Slack): next to the mp4, so the delivery folder is self-contained.
	writeJson(path.join(dest, `${slug}.json`), {
		repo: facts.repo, number: facts.number, url: facts.url, title: facts.title, author: facts.authorLogin, headline,
		seconds: +project.video.total.toFixed(1), voice: voiceInfo.provider, mp4: `${slug}.mp4`, ...(webm ? { webm: `${slug}.webm` } : {}), srt: `${slug}.srt`, published: new Date().toISOString(),
		// What the video used, so the history (the variety of the next videos) can be rebuilt from the delivered files.
		motion: video.motion, treatments: Object.fromEntries(meta.map(id => [id, video.beats[id].treatment])),
	});
	console.log(`delivered: ${path.join(dest, `${slug}.mp4`)}${earlier ? ` (replacing the video delivered there on ${earlier.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })})` : ''}`);
	return path.join(dest, `${slug}.mp4`);
}

/** The repository's gallery: storyboard, direction and contact sheet (never the scene code: agents must not copy old
 * videos), and a short animated preview for the README. */
async function addToGallery(slug, { vdir, bdir, mp4 }) {
	const gdir = path.join(ROOT, 'gallery', slug);
	fs.mkdirSync(gdir, { recursive: true });
	fs.copyFileSync(path.join(vdir, 'storyboard.json'), path.join(gdir, 'storyboard.json'));
	if (fs.existsSync(path.join(vdir, 'direction.json'))) {
		fs.copyFileSync(path.join(vdir, 'direction.json'), path.join(gdir, 'direction.json'));
	}
	fs.copyFileSync(path.join(bdir, 'contact.png'), path.join(gdir, 'contact.png'));
	if (process.env.COPILOT_AGENT_SESSION_ID || process.env.CI) {
		console.log('(no gallery preview in an automated run: only the README gallery uses it)');
		return;
	}
	const { makePreview } = await import('./gallery.mjs');
	try {
		await makePreview(slug, { mp4, out: path.join(gdir, 'preview.webp') });
		console.log('for the README gallery: prs gallery --upload');
	} catch (error) {
		console.log(`(no gallery preview: ${String(error.message).split('\n')[0].slice(0, 120)})`);
	}
}


==> cli/lib/render.mjs  text 6937
// prs render / prs draft: frames for the final video.
// - Several browser processes (screenshots serialize inside one browser): ~4x faster than tabs in one browser.
// - Content-addressed cache: a frame is captured only if no frame with the same DOM fingerprint was captured before
//   (holds, repeated states and unchanged beats from earlier runs cost nothing).
// - Captions are not in these frames: each caption state is captured once and ffmpeg composites them per frame.
// - Motion blur only where the camera moves (canvas mode).
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { launch, openVideo } from './browser.mjs';
import { buildDir, findFfmpeg, loadConfig, readJson, sha256, writeJson } from './common.mjs';

const run = promisify(execFile);

function saidCount(chunk, t) {
	let n = 0;
	for (const w of chunk.words) {
		if (t >= w.a - 0.02) {
			n++;
		}
	}
	return n;
}

export function captionStateAt(chunks, t) {
	const c = chunks.findIndex(ch => t >= ch.start && t < ch.end);
	return c < 0 ? null : `${c}-${saidCount(chunks[c], t)}`;
}

function linkOrCopy(from, to) {
	try {
		fs.linkSync(from, to);
	} catch {
		fs.copyFileSync(from, to);
	}
}

export async function render(slug, { draft = false, workers = 0 } = {}) {
	const bdir = buildDir(slug);
	const project = readJson(path.join(bdir, 'project.json'));
	const lock = readJson(path.join(bdir, 'build.lock.json'));
	const fps = draft ? 15 : 30;
	const scale = draft ? 0.5 : 1;
	const total = project.video.total;
	const count = Math.ceil(total * fps);
	const outDir = path.join(bdir, draft ? 'frames-draft' : 'frames');
	const capDir = path.join(bdir, draft ? 'captions-draft' : 'captions');
	const cacheDir = path.join(bdir, 'cache', `x${scale}`);
	fs.rmSync(outDir, { recursive: true, force: true });
	fs.rmSync(capDir, { recursive: true, force: true });
	fs.mkdirSync(outDir, { recursive: true });
	fs.mkdirSync(capDir, { recursive: true });
	fs.mkdirSync(cacheDir, { recursive: true });
	const salt = sha256(fs.readFileSync(path.join(bdir, 'bundle.css')) + String(scale)).slice(0, 16);
	const config = loadConfig();
	const cpus = os.cpus().length;
	const nBrowsers = workers || config.render.workers || Math.max(2, Math.min(8, Math.floor(cpus / 2)));
	const pagesPer = 2;
	const browsers = await Promise.all(Array.from({ length: nBrowsers }, () => launch()));
	const t0 = performance.now();
	let captured = 0, reused = 0, blurred = 0;
	try {
		const first = await openVideo(browsers[0], bdir, { mode: 'content', scale });
		const meta = await first.meta();
		await first.page.close();
		const blurWindows = draft ? [] : meta.blurWindows ?? [];
		const inBlur = t => blurWindows.some(([a, b]) => t > a && t < b);
		const ffmpeg = findFfmpeg();
		// Content frames: contiguous chunks per worker.
		const pages = [];
		for (const b of browsers) {
			for (let i = 0; i < pagesPer; i++) {
				pages.push(openVideo(b, bdir, { mode: 'content', scale }));
			}
		}
		const views = await Promise.all(pages);
		let next = 0;
		const CHUNK = 24;
		const capture = async (v, t) => {
			await v.renderAt(t);
			const sig = await v.page.evaluate(() => window.frameSignature());
			const key = sha256(salt + sig).slice(0, 24);
			const file = path.join(cacheDir, `${key}.png`);
			if (!fs.existsSync(file)) {
				const tmp = `${file}.${process.pid}.${Math.random().toString(36).slice(2)}.tmp`;
				await v.page.screenshot({ path: tmp, type: 'png' });
				fs.renameSync(tmp, file);
				captured++;
			} else {
				reused++;
			}
			return { key, file };
		};
		await Promise.all(views.map(async v => {
			while (next < count) {
				const start = next;
				next += CHUNK;
				for (let f = start; f < Math.min(count, start + CHUNK); f++) {
					const t = f / fps;
					const out = path.join(outDir, `${String(f).padStart(5, '0')}.png`);
					if (inBlur(t)) {
						// 180-degree shutter sampled six times, averaged: a smooth blur while the camera flies.
						const N = 6;
						const samples = [];
						for (let k = 0; k < N; k++) {
							samples.push(await capture(v, t + (((k + 0.5) / N) - 0.5) * 0.5 / fps));
						}
						const distinct = [...new Set(samples.map(x => x.key))];
						const key = sha256(samples.map(x => x.key).join('|')).slice(0, 24);
						const file = path.join(cacheDir, `mb-${key}.png`);
						if (!fs.existsSync(file)) {
							if (distinct.length === 1) {
								linkOrCopy(samples[0].file, file);
							} else {
								const tmp = `${file}.${process.pid}.tmp.png`;
								await run(ffmpeg, ['-v', 'error', '-y', ...samples.flatMap(x => ['-i', x.file]), '-filter_complex', `mix=inputs=${N}`, '-frames:v', '1', tmp]);
								fs.renameSync(tmp, file);
								blurred++;
							}
						}
						linkOrCopy(file, out);
					} else {
						linkOrCopy((await capture(v, t)).file, out);
					}
				}
			}
		}));
		await Promise.all(views.map(v => v.page.close()));
		// Caption states: one image per (phrase, words said); frames link to them.
		const capView = await openVideo(browsers[0], bdir, { mode: 'captions', scale });
		const chunks = meta.chunks;
		// Playwright clips in CSS pixels; the image comes out at the device scale (960x70 for a draft).
		const band = { x: 0, y: 940, width: 1920, height: 140 };
		const states = new Map();
		const blank = path.join(capDir, 'blank.png');
		await capView.page.evaluate(() => window.showCaption(-1, 0));
		await capView.page.screenshot({ path: blank, clip: band, omitBackground: true });
		for (let f = 0; f < count; f++) {
			const state = captionStateAt(chunks, f / fps);
			let file = blank;
			if (state) {
				if (!states.has(state)) {
					const [c, s] = state.split('-').map(Number);
					const p = path.join(capDir, `state-${state}.png`);
					await capView.page.evaluate(([cc, ss]) => window.showCaption(cc, ss), [c, s]);
					await capView.page.screenshot({ path: p, clip: band, omitBackground: true });
					states.set(state, p);
				}
				file = states.get(state);
			}
			linkOrCopy(file, path.join(capDir, `${String(f).padStart(5, '0')}.png`));
		}
		await capView.page.close();
		const seconds = (performance.now() - t0) / 1000;
		writeJson(path.join(outDir, 'render.json'), {
			slug, fps, scale, count, total, project: lock.project, bundle: lock.bundle, captured, reused, blurred, captionStates: states.size, seconds: +seconds.toFixed(1), browsers: nBrowsers,
		});
		console.log(`rendered ${count} frames in ${seconds.toFixed(1)} s: ${captured} captured, ${reused} reused from cache${blurred ? `, ${blurred} motion-blurred` : ''}; ${states.size} caption states (${nBrowsers} browsers)`);
		if (draft) {
			const { encode } = await import('./encode.mjs');
			const out = path.join(bdir, 'draft.mp4');
			await encode(slug, { draft: true, out });
			console.log(`draft: ${out}`);
		}
	} finally {
		await Promise.all(browsers.map(b => b.close()));
	}
}

==> cli/lib/report.mjs  text 1185
// prs report: where the time went (from build/timings.jsonl).
import fs from 'node:fs';
import path from 'node:path';
import { buildDir } from './common.mjs';

export function report(slug) {
	const file = path.join(buildDir(slug), 'timings.jsonl');
	if (!fs.existsSync(file)) {
		console.log('No timings yet.');
		return;
	}
	const rows = fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).map(l => JSON.parse(l));
	const byPhase = new Map();
	for (const r of rows) {
		const e = byPhase.get(r.phase) ?? { runs: 0, total: 0, last: 0 };
		e.runs++;
		e.total += r.seconds;
		e.last = r.seconds;
		byPhase.set(r.phase, e);
	}
	const first = new Date(rows[0].at), last = new Date(rows.at(-1).at);
	console.log(`${slug}: ${rows.length} tool runs over ${((last - first) / 60000).toFixed(1)} min of work`);
	console.log('phase        runs   last (s)   total (s)');
	let sum = 0;
	for (const [phase, e] of byPhase) {
		sum += e.total;
		console.log(`${phase.padEnd(12)} ${String(e.runs).padStart(4)} ${e.last.toFixed(1).padStart(10)} ${e.total.toFixed(1).padStart(11)}`);
	}
	console.log(`tools total: ${sum.toFixed(1)} s; the rest of the elapsed time was writing and reviewing.`);
}

