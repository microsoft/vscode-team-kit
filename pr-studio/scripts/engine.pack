// prs doctor: check and install what the pipeline needs. Safe to run again; it only adds what is missing.
import fs from 'node:fs';
import path from 'node:path';
import { execFileSync, spawnSync } from 'node:child_process';
import { CACHE, CONFIG_FILE, DEFAULT_CONFIG, ROOT, isOffline, loadConfig, sha256File, voicePace, writeJson } from './common.mjs';
import { chromePath } from './browser.mjs';

const KOKORO = {
	'kokoro-v1.0.int8.onnx': 'https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.int8.onnx',
	'voices-v1.0.bin': 'https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin',
};
const APTOS = ['Microsoft Excel', 'Microsoft Word', 'Microsoft PowerPoint'].map(app => `/Applications/${app}.app/Contents/Resources/DFonts/Aptos.ttf`);

const ok = m => console.log(`  \u2713 ${m}`);
const warn = m => console.log(`  ! ${m}`);
const fail = m => console.log(`  \u2717 ${m}`);

function findPython() {
	for (const c of ['/opt/homebrew/bin/python3.12', '/opt/homebrew/bin/python3.11', '/opt/homebrew/bin/python3.13', '/usr/local/bin/python3.12', '/usr/local/bin/python3.11', 'python3.12', 'python3.11', 'python3.13', 'python3']) {
		const r = spawnSync(c, ['-c', 'import sys; print(sys.version_info[:2] >= (3, 10) and sys.version_info[:2] < (3, 14))'], { encoding: 'utf8' });
		if (r.status === 0 && r.stdout.trim() === 'True') {
			return c;
		}
	}
	return null;
}

async function download(url, file) {
	const res = await fetch(url);
	if (!res.ok) {
		throw new Error(`download failed (${res.status}): ${url}`);
	}
	const tmp = `${file}.part`;
	fs.writeFileSync(tmp, Buffer.from(await res.arrayBuffer()));
	fs.renameSync(tmp, file);
}

export async function doctor({ samples = false, deck = false } = {}) {
	let problems = 0;
	console.log('pr-studio doctor');
	const major = Number(process.versions.node.split('.')[0]);
	major >= 20 ? ok(`node ${process.versions.node}`) : (fail(`node ${process.versions.node}: needs 20 or newer`), problems++);
	if (isOffline()) {
		ok('GitHub: offline (PRS_OFFLINE), from what prs new downloaded before this run');
	} else {
		try {
			// A repos/ call, not /rate_limit: the cloud agent's firewall rule may allow only https://api.github.com/repos/.
			const { request, githubToken } = await import('./github.mjs');
			const { headers, blocked } = await request('https://api.github.com/repos/microsoft/vscode');
			const source = process.env.PRS_GITHUB_TOKEN ? 'PRS_GITHUB_TOKEN' : process.env.GH_TOKEN ? 'GH_TOKEN' : process.env.GITHUB_TOKEN ? 'GITHUB_TOKEN' : githubToken() ? 'gh' : 'no token';
			const limit = Number(headers.get('x-ratelimit-limit') ?? 0), remaining = Number(headers.get('x-ratelimit-remaining') ?? 0);
			blocked ? warn('GitHub API blocked by the agent firewall: only the PRs named in the request (prefetched by the setup steps) can be read; allow https://api.github.com/repos/ for the rest')
				: limit > 60 || !limit ? ok(`GitHub API (${source}${limit ? `, ${remaining}/${limit} requests left this hour` : ''})`) : warn(`GitHub API without a token: ${remaining}/60 requests left this hour (enough for a few PRs; set PRS_GITHUB_TOKEN or sign in with gh for more)`);
		} catch (error) {
			fail(`GitHub API: ${error.message}`);
			problems++;
		}
	}
	if (!fs.existsSync(path.join(ROOT, 'node_modules', 'esbuild'))) {
		console.log('  installing node packages...');
		execFileSync('npm', ['install', '--silent'], { cwd: ROOT, stdio: 'inherit' });
	}
	ok('node packages');
	if (!chromePath()) {
		console.log('  installing Chrome for Testing...');
		const withDeps = process.platform === 'linux' && process.env.CI ? ['--with-deps'] : [];
		execFileSync('npx', ['playwright-core', 'install', ...withDeps, 'chromium'], { cwd: ROOT, stdio: 'inherit' });
	}
	chromePath() ? ok('Chrome for Testing') : (fail('Chrome for Testing could not be installed'), problems++);

	// Slides need only the packages and the browser; videos also need the voice.
	if (!deck) {
		// Voice environment: Kokoro (offline voice), faster-whisper (word timing, sync gate), ffmpeg.
		const venv = path.join(CACHE, 'venv');
		const py = path.join(venv, 'bin', 'python');
		if (!fs.existsSync(py)) {
			const base = findPython();
			if (!base) {
				fail('Python 3.10-3.13 not found (brew install python@3.12)');
				problems++;
			} else {
				console.log(`  creating the voice environment with ${base}...`);
				fs.mkdirSync(CACHE, { recursive: true });
				execFileSync(base, ['-m', 'venv', venv], { stdio: 'inherit' });
			}
		}
		if (fs.existsSync(py)) {
			// Pinned versions; installed again whenever voice/requirements.txt changes.
			const requirements = path.join(ROOT, 'voice', 'requirements.txt');
			const stamp = path.join(venv, '.prs-requirements');
			const installed = fs.existsSync(stamp) ? fs.readFileSync(stamp, 'utf8').trim() : '';
			const check = spawnSync(py, ['-c', 'import kokoro_onnx, faster_whisper, soundfile, numpy, imageio_ffmpeg'], { encoding: 'utf8' });
			if (check.status !== 0 || installed !== sha256File(requirements)) {
				console.log('  installing voice packages (voice/requirements.txt)...');
				execFileSync(py, ['-m', 'pip', 'install', '-q', '--upgrade', 'pip'], { stdio: 'inherit' });
				execFileSync(py, ['-m', 'pip', 'install', '-q', '-r', requirements], { stdio: 'inherit' });
				fs.writeFileSync(stamp, sha256File(requirements));
			}
			ok('voice environment');
			const bin = path.join(CACHE, 'bin', 'ffmpeg');
			if (!fs.existsSync(bin)) {
				const exe = execFileSync(py, ['-c', 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())'], { encoding: 'utf8' }).trim();
				fs.mkdirSync(path.dirname(bin), { recursive: true });
				fs.symlinkSync(exe, bin);
			}
			ok(`ffmpeg (${fs.realpathSync(bin)})`);
			const kdir = path.join(CACHE, 'kokoro');
			fs.mkdirSync(kdir, { recursive: true });
			for (const [name, url] of Object.entries(KOKORO)) {
				if (!fs.existsSync(path.join(kdir, name))) {
					console.log(`  downloading ${name}...`);
					await download(url, path.join(kdir, name));
				}
			}
			ok('Kokoro voice model (Apache-2.0)');
			const w = spawnSync(py, ['-c', 'from faster_whisper import WhisperModel; WhisperModel("small.en", compute_type="int8")'], { encoding: 'utf8', env: { ...process.env, HF_HUB_DISABLE_TELEMETRY: '1', ...(isOffline() ? { HF_HUB_OFFLINE: '1' } : {}) } });
			w.status === 0 ? ok('Whisper small.en (word timing and the sync gate)') : (fail(`Whisper model: ${w.stderr.trim().split('\n').at(-1)}`), problems++);
			if (samples) {
				const out = path.join(loadConfig().deliver, 'voice-samples');
				spawnSync(py, [path.join(ROOT, 'voice', 'voice.py'), 'samples', '--out', out], { stdio: 'inherit', env: { ...process.env, PRS_FFMPEG: bin } });
			}
		}
	}
	APTOS.some(f => fs.existsSync(f)) ? ok('Aptos (from Microsoft Office; read in place, never copied)') : warn('Aptos not found (Microsoft Office): videos use Segoe UI or Inter instead');
	const config = loadConfig();
	if (!fs.existsSync(CONFIG_FILE)) {
		writeJson(CONFIG_FILE, DEFAULT_CONFIG);
		ok(`wrote ${CONFIG_FILE} (your settings)`);
	}
	const mai = config.voice.mai;
	const pace = deck ? 1 : voicePace(config);
	const faster = pace === 1 ? '' : `; ${pace}\u00d7 its own pace (voice.pace)`;
	if (deck) {
		// Slides have no voice.
	} else if (process.env.AZURE_SPEECH_KEY) {
		ok(`voice: MAI-Voice-2 (${mai.voice}) via AZURE_SPEECH_KEY${faster}`);
	} else if (mai.azResource) {
		ok(`voice: MAI-Voice-2 via az lookup of ${mai.azResource}, Kokoro when that fails${faster}`);
	} else {
		ok(`voice: Kokoro ${config.voice.kokoro.voice} (offline)${faster}. For MAI-Voice-2, set AZURE_SPEECH_KEY or voice.mai.azResource in ${CONFIG_FILE}`);
	}
	console.log(problems ? `${problems} problem${problems > 1 ? 's' : ''} to fix` : deck ? 'ready for slides' : 'ready');
	return !problems;
}

==> cli/lib/encode.mjs  text 3272
// Encode: content frames + caption states (overlaid) + progress line (drawn by ffmpeg) + narration -> H.264/AAC mp4.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
import { buildDir, findFfmpeg, readJson } from './common.mjs';

const run = promisify(execFile);

export async function encode(slug, { draft = false, out }) {
	const bdir = buildDir(slug);
	const frames = path.join(bdir, draft ? 'frames-draft' : 'frames');
	const caps = path.join(bdir, draft ? 'captions-draft' : 'captions');
	const info = readJson(path.join(frames, 'render.json'));
	const { fps, scale, count, total } = info;
	const W = Math.round(1920 * scale), BAR = Math.max(2, Math.round(6 * scale));
	const narration = path.join(bdir, 'narration.wav');
	const hasAudio = fs.existsSync(narration);
	const filter = [
		`[0:v][1:v]overlay=0:${Math.round(940 * scale)}:format=rgb[a]`,
		`[a]drawbox=x=0:y=${Math.round(1080 * scale) - BAR}:w=${W}:h=${BAR}:color=0xeef0f3@1:t=fill[b]`,
		`[b][2:v]overlay=x='-w+w*t/${total}':y=${Math.round(1080 * scale) - BAR}:format=rgb:shortest=1[c]`,
		'[c]scale=out_color_matrix=bt709:out_range=tv:flags=lanczos+accurate_rnd+full_chroma_int,format=yuv420p,setparams=range=tv:color_primaries=bt709:color_trc=bt709:colorspace=bt709[v]',
	].join(';');
	const args = [
		'-hide_banner', '-v', 'error', '-y',
		'-framerate', String(fps), '-i', path.join(frames, '%05d.png'),
		'-framerate', String(fps), '-i', path.join(caps, '%05d.png'),
		'-f', 'lavfi', '-i', `color=c=0x0078d4:s=${W}x${BAR}:r=${fps}`,
		...(hasAudio ? ['-i', narration] : []),
		'-filter_complex', filter, '-map', '[v]',
		...(hasAudio ? ['-map', '3:a', '-af', 'apad', '-c:a', 'aac', '-b:a', '128k', '-ar', '48000'] : []),
		'-c:v', 'libx264', '-pix_fmt', 'yuv420p', '-x264-params', 'colorprim=bt709:transfer=bt709:colormatrix=bt709:range=tv',
		'-colorspace', 'bt709', '-color_primaries', 'bt709', '-color_trc', 'bt709', '-color_range', 'tv',
		// Slides are mostly still frames: on a small machine (the 2-core cloud runner) 'faster' looks the same and saves a minute.
		'-crf', draft ? '28' : '23', '-maxrate', '3500k', '-bufsize', '7000k', '-preset', draft ? 'veryfast' : os.cpus().length <= 4 ? 'faster' : 'medium',
		'-frames:v', String(count), ...(hasAudio ? ['-shortest'] : []), '-movflags', '+faststart', out,
	];
	await run(findFfmpeg(), args, { maxBuffer: 16 * 1024 * 1024 });
	return { out, hasAudio };
}

/**
 * The same video as WebM (VP9 and Opus) for VS Code's chat, whose window can't decode MP4. Best effort: an ffmpeg
 * without these encoders only costs the preview, and the mp4 is delivered as usual. Returns whether it was written.
 */
export async function encodeWebm(mp4, webm) {
	try {
		await run(findFfmpeg(), ['-v', 'error', '-y', '-i', mp4, '-c:v', 'libvpx-vp9', '-pix_fmt', 'yuv420p', '-crf', '30', '-b:v', '0', '-deadline', 'good', '-cpu-used', '4', '-row-mt', '1', '-c:a', 'libopus', '-b:a', '96k', webm], { maxBuffer: 16 * 1024 * 1024 });
		return true;
	} catch (e) {
		fs.rmSync(webm, { force: true });
		console.warn(`no WebM for VS Code's chat preview (${String(e.message).split('\n')[0]}); the mp4 is delivered as usual`);
		return false;
	}
}

==> cli/lib/evidence.mjs  text 4184
// Evidence for storyboard claims, checked against the PR. Accepted forms:
//   { file, anchor }               the anchor (text or regex) is in the file at the head commit (any file of the
//                                  repository, changed or not: behaviour that lives outside the diff)
//   { file, anchor, removed: true } the anchor is on a line this PR removes (pr.diff)
//   { body: "exact text" }          an exact quote of the PR description (Markdown markers ignored)
//   { commit: "exact text" }        part of a commit message
//   { review: "exact text" }        words from the review discussion (reviews, comments on lines, the conversation)
//   { fact: "additions" }           a value in pr.json facts (also "facts.additions")
//   { file, status }                the PR changes that file
import fs from 'node:fs';
import path from 'node:path';
import { videoDir } from './common.mjs';
import { fileAtHead } from './code.mjs';

const norm = s => String(s).replace(/\s+/g, ' ').trim();

/** Markdown out of the way: **bold**, `code`, [text](url), > quotes, list bullets. */
export function stripMarkdown(text) {
	return String(text)
		.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
		.replace(/(\*\*|__|`)/g, '')
		.replace(/^\s*>\s?/gm, '')
		.replace(/^\s*[-*+]\s+/gm, '');
}

export function bodyCorpus(pr) {
	return `${norm(pr.body ?? '')}\n${norm(stripMarkdown(pr.body ?? ''))}`;
}

/** What people said in review, as plain text (Markdown markers ignored). */
export function reviewCorpus(pr) {
	return (pr.discussion ?? []).map(d => `${norm(d.body)}\n${norm(stripMarkdown(d.body))}`).join('\n');
}

export function removedLines(slug, file) {
	const diff = fs.readFileSync(path.join(videoDir(slug), 'pr.diff'), 'utf8');
	const out = [];
	let current = null;
	for (const line of diff.split('\n')) {
		const m = line.match(/^diff --git a\/(.+?) b\/(.+)$/);
		if (m) {
			current = m[2];
			continue;
		}
		if (current === file && line.startsWith('-') && !line.startsWith('---')) {
			out.push(line.slice(1));
		}
	}
	return out.join('\n');
}

function anchorIn(text, anchor) {
	if (text.includes(anchor)) {
		return true;
	}
	try {
		return new RegExp(anchor).test(text);
	} catch {
		return false;
	}
}

/** Returns null when the evidence holds, else a message saying what to fix. */
export function checkEvidence(slug, pr, ev) {
	if (ev.fact !== undefined) {
		const key = String(ev.fact).replace(/^facts\./, '');
		return key.split('.').reduce((o, k) => (o === undefined || o === null ? undefined : o[k]), pr.facts) === undefined ? `fact "${ev.fact}" is not in pr.json facts` : null;
	}
	if (ev.pr_body !== undefined && ev.body === undefined) {
		ev = { ...ev, body: ev.pr_body };
	}
	if (ev.body !== undefined) {
		return bodyCorpus(pr).includes(norm(stripMarkdown(ev.body))) ? null : `body quote not found in the PR description: "${ev.body}"`;
	}
	if (ev.review !== undefined) {
		return reviewCorpus(pr).includes(norm(stripMarkdown(ev.review))) ? null : `not in the review discussion (brief.md, "Review discussion"): "${ev.review}"`;
	}
	if (ev.commit !== undefined) {
		return (pr.facts.commits ?? []).some(c => norm(c.message ?? c.headline).includes(norm(ev.commit))) ? null : `no commit message contains "${ev.commit}"`;
	}
	if (!ev.file) {
		return 'evidence needs { file, anchor }, { file, anchor, removed: true }, { body }, { commit } or { review }';
	}
	if (/^(brief\.md|pr\.json|pr\.diff|storyboard\.json)$/.test(ev.file)) {
		return `"${ev.file}" is a pr-studio file, not part of the PR: cite the repository file, or use { body: "exact quote" } for the PR description`;
	}
	if (ev.status !== undefined && !ev.anchor) {
		return pr.facts.files.some(f => f.path === ev.file) ? null : `${ev.file} is not changed by this PR`;
	}
	if (ev.removed) {
		return anchorIn(removedLines(slug, ev.file), ev.anchor ?? '') ? null : `"${ev.anchor}" is not on a line this PR removes from ${ev.file}`;
	}
	try {
		const text = fileAtHead(slug, pr.facts, ev.file);
		return !ev.anchor || anchorIn(text, ev.anchor) ? null : `"${ev.anchor}" is not in ${ev.file} at ${pr.facts.headSha9} (for a removed line add removed: true)`;
	} catch (error) {
		return error.message;
	}
}

