		{
			id: 'statement-dark', layout: 'statement', bg: 'dark', eyebrow: 'The lesson',
			text: 'Fast is easy to ship. {{blue|Trustworthy takes a check.}}', notes: 'A statement on a dark page, for rhythm.',
