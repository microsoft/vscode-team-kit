==> deck/theme/studio.css  text 6567
/* The studio look for slides: the tokens of theme/studio.css (the videos), with the extras a deck needs (page size,
   tones as classes, yellow, pill sizes). Every slide is one 1920x1080 page of a PDF instead of one frame of a video. */

/* Aptos is read from the local Microsoft Office install at build time (its licence allows embedding in documents).
   Without Office the stack falls back to Segoe UI, then Inter (bundled, OFL). */
@font-face { font-family: 'Aptos'; font-weight: 400; src: url('file:///Applications/Microsoft%20PowerPoint.app/Contents/Resources/DFonts/Aptos.ttf'), url('file:///Applications/Microsoft%20Word.app/Contents/Resources/DFonts/Aptos.ttf'), url('file:///Applications/Microsoft%20Excel.app/Contents/Resources/DFonts/Aptos.ttf'); }
@font-face { font-family: 'Aptos'; font-weight: 600; src: url('file:///Applications/Microsoft%20PowerPoint.app/Contents/Resources/DFonts/Aptos-SemiBold.ttf'), url('file:///Applications/Microsoft%20Word.app/Contents/Resources/DFonts/Aptos-SemiBold.ttf'), url('file:///Applications/Microsoft%20Excel.app/Contents/Resources/DFonts/Aptos-SemiBold.ttf'); }
@font-face { font-family: 'Aptos'; font-weight: 700; src: url('file:///Applications/Microsoft%20PowerPoint.app/Contents/Resources/DFonts/Aptos-Bold.ttf'), url('file:///Applications/Microsoft%20Word.app/Contents/Resources/DFonts/Aptos-Bold.ttf'), url('file:///Applications/Microsoft%20Excel.app/Contents/Resources/DFonts/Aptos-Bold.ttf'); }
@font-face { font-family: 'Aptos'; font-weight: 400; font-style: italic; src: url('file:///Applications/Microsoft%20PowerPoint.app/Contents/Resources/DFonts/Aptos-Italic.ttf'), url('file:///Applications/Microsoft%20Word.app/Contents/Resources/DFonts/Aptos-Italic.ttf'); }
@font-face { font-family: 'Inter'; font-weight: 400; src: url('../../node_modules/@fontsource/inter/files/inter-latin-400-normal.woff2') format('woff2'); }
@font-face { font-family: 'Inter'; font-weight: 600; src: url('../../node_modules/@fontsource/inter/files/inter-latin-600-normal.woff2') format('woff2'); }
@font-face { font-family: 'Inter'; font-weight: 700; src: url('../../node_modules/@fontsource/inter/files/inter-latin-700-normal.woff2') format('woff2'); }
@font-face { font-family: 'JetBrains Mono'; font-weight: 400; src: url('../../node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2') format('woff2'); }
@font-face { font-family: 'JetBrains Mono'; font-weight: 600; src: url('../../node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-600-normal.woff2') format('woff2'); }
@font-face { font-family: 'JetBrains Mono'; font-weight: 700; src: url('../../node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2') format('woff2'); }

:root {
	--ink: #1b1b1f;
	--body: #5f6168;
	--muted: #72767e; /* the videos use #767a82 (4.31:1); a touch darker passes WCAG AA (4.56:1) for small text on a projector */
	--faint: #b9bcc4;
	--line: #e3e6eb;
	--line-strong: #d3d8e0;
	--surface: #f5f6f8;
	--surface-2: #fafbfc;
	--track: #eef0f3;
	--connector: #b6c2d3;
	--blue: #0078d4;
	--blue-tint: #eef4fd;
	--green: #107c10;
	--green-tint: #eef7ea;
	--red: #d13438;
	--red-tint: #fbeeed;
	--orange: #d83b01;
	--orange-tint: #fcf1ec;
	--purple: #8661c5;
	--purple-tint: #f3effa;
	--yellow: #9a6700; /* amber: GitHub's "attention" text colour, passes WCAG AA on white and on its tint */
	--yellow-tint: #fff6d4;
	--neutral: #5f6168;
	--neutral-tint: #f5f6f8;
	--sans: 'Aptos', 'Segoe UI', 'Inter', system-ui, sans-serif;
	--mono: 'Menlo', 'Cascadia Mono', 'Consolas', 'JetBrains Mono', monospace;
}

@page { size: 1920px 1080px; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: #fff; }
body { font-family: var(--sans); color: var(--ink); -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision; font-feature-settings: 'tnum' 1, 'lnum' 1; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

/* Typography (same scale as pr-studio) */
.st-eyebrow { font-size: 21px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--blue); white-space: nowrap; }
.st-title { font-size: 56px; font-weight: 600; letter-spacing: -.012em; line-height: 1.12; color: var(--ink); }
.st-title-xl { font-size: 78px; font-weight: 600; letter-spacing: -.02em; line-height: 1.08; color: var(--ink); }
.st-sub { font-size: 27px; line-height: 1.4; color: var(--body); }
.st-h3 { font-size: 30px; font-weight: 600; line-height: 1.25; color: var(--ink); }
.st-h4 { font-size: 26px; font-weight: 600; line-height: 1.25; color: var(--ink); }
.st-body { font-size: 24px; line-height: 1.42; color: var(--body); }
.st-small { font-size: 20px; line-height: 1.4; color: var(--body); }
.st-foot { font-size: 18px; line-height: 1.4; color: var(--muted); }
.st-label { font-size: 17px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
.st-mono { font-family: var(--mono); }
.st-num { font-weight: 700; letter-spacing: -.02em; line-height: 1; font-variant-numeric: tabular-nums; }
strong { font-weight: 600; color: var(--ink); }
code { font-family: var(--mono); font-size: .86em; background: var(--surface); border: 1.5px solid var(--line); border-radius: 8px; padding: 0 .3em; color: var(--ink); white-space: nowrap; }

/* Surfaces */
.st-card { background: #fff; border: 1.5px solid var(--line); border-radius: 18px; }
.st-tile { border-radius: 18px; }

/* Pills and badges */
.st-pill { display: inline-flex; align-items: center; gap: 10px; height: 44px; padding: 0 18px; border-radius: 999px; font-size: 21px; font-weight: 600; white-space: nowrap; }
.st-pill--s { height: 36px; padding: 0 14px; font-size: 18px; gap: 8px; }
.st-pill--l { height: 54px; padding: 0 22px; font-size: 24px; gap: 12px; }
.st-badge { display: inline-grid; place-items: center; border-radius: 50%; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; flex: none; }

/* Tones: .t-blue etc. set --fg/--tint for any component */
.t-blue { --fg: var(--blue); --tint: var(--blue-tint); }
.t-green { --fg: var(--green); --tint: var(--green-tint); }
.t-red { --fg: var(--red); --tint: var(--red-tint); }
.t-orange { --fg: var(--orange); --tint: var(--orange-tint); }
.t-purple { --fg: var(--purple); --tint: var(--purple-tint); }
.t-yellow { --fg: var(--yellow); --tint: var(--yellow-tint); }
.t-neutral { --fg: var(--body); --tint: var(--surface); }

.ic { display: inline-block; flex: none; line-height: 0; }
.ic svg { display: block; width: 100%; height: 100%; }

==> engine/motion.js  text 2215
// Easing and timing. Everything on screen is a pure function of time t (no CSS transitions, no requestAnimationFrame),
// so any frame can be rendered alone, in any order, and identical frames can be detected and skipped.

export const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
export const lerp = (a, b, p) => a + (b - a) * p;
export const prog = (t, a, b) => (b === a ? (t >= b ? 1 : 0) : clamp((t - a) / (b - a)));

function cubicBezier(x1, y1, x2, y2) {
	const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
	const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
	const sx = u => ((ax * u + bx) * u + cx) * u;
	const sy = u => ((ay * u + by) * u + cy) * u;
	const dx = u => (3 * ax * u + 2 * bx) * u + cx;
	return x => {
		if (x <= 0) {
			return 0;
		}
		if (x >= 1) {
			return 1;
		}
		let u = x;
		for (let i = 0; i < 8; i++) {
			const d = dx(u);
			if (Math.abs(d) < 1e-6) {
				break;
			}
			u -= (sx(u) - x) / d;
		}
		return sy(clamp(u));
	};
}

/** Fluent motion curves: decelerate (entrances), standard (moves), accelerate (exits). */
export const decel = cubicBezier(0.1, 0.9, 0.2, 1);
export const standard = cubicBezier(0.8, 0, 0.2, 1);
export const accel = cubicBezier(0.9, 0.1, 1, 0.2);
export const easeInOutCubic = p => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);

/** Fade + slide in at `at`. Returns the eased progress (0..1). */
export function enter(node, t, at, { dur = 0.6, dy = 14, dx = 0, scale = 0, from = 0 } = {}) {
	const p = decel(prog(t, at, at + dur));
	node.style.opacity = String(lerp(from, 1, p));
	node.style.transform = `translate(${(1 - p) * dx}px, ${(1 - p) * dy}px)${scale ? ` scale(${1 - (1 - p) * scale})` : ''}`;
	return p;
}

/** Fade out at `at` (multiplies the current opacity). */
export function leave(node, t, at, { dur = 0.4, to = 0 } = {}) {
	const p = standard(prog(t, at, at + dur));
	node.style.opacity = String(Number(node.style.opacity || 1) * lerp(1, to, p));
	return p;
}

/** A number that counts up with an ease-out. */
export function count(t, at, dur, to, from = 0) {
	return Math.round(lerp(from, to, decel(prog(t, at, at + dur))));
}

export const fmt = n => Number(n).toLocaleString('en-US');

==> engine/runtime.js  text 3759
// Browser entry. Builds the frame for any time t; the renderer, stills and lint drive it through window.renderAt.
// URL params: mode=all|content|captions  (content = no captions/progress; captions = only the caption pill, transparent)
import '../theme/studio.css';
import { el, setFacts } from '../theme/primitives.js';
import { buildChunks, captions } from '../theme/captions.js';
import { chrome } from '../theme/chrome.js';
import { endCard } from '../theme/endcard.js';
import { createStage } from './stage.js';
import { fact } from './text.js';

async function loadFonts() {
	const want = ['400 30px Aptos', '600 30px Aptos', '700 30px Aptos', '400 30px Inter', '600 30px Inter', '700 30px Inter', '400 20px Menlo', '400 20px "JetBrains Mono"', '600 20px "JetBrains Mono"'];
	const loaded = await Promise.all(want.map(f => document.fonts.load(f).catch(() => [])));
	await document.fonts.ready;
	return { aptos: loaded.slice(0, 3).every(list => list.length) };
}

/** cyrb53: fast 53-bit string hash, enough to tell frames apart. */
function hash(str) {
	let h1 = 0xdeadbeef ^ str.length, h2 = 0x41c6ce57 ^ str.length;
	for (let i = 0; i < str.length; i++) {
		const ch = str.charCodeAt(i);
		h1 = Math.imul(h1 ^ ch, 2654435761);
		h2 = Math.imul(h2 ^ ch, 1597334677);
	}
	h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
	h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
	return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(36);
}

export async function start(video, project) {
	const params = new URLSearchParams(location.search);
	const mode = params.get('mode') ?? 'all';
	document.body.classList.add(`mode-${mode}`);
	const fonts = await loadFonts();
	setFacts(project.pr.facts);
	const app = document.getElementById('app');
	const stage = createStage(app, video, project);
	const titleEntry = stage.entries[0];
	const end = endCard(stage.root, project.pr.facts, { headline: titleEntry.spec.params?.headline ?? fact('title') });
	end.layout();
	const { endAt, total } = project.video;
	const ch = chrome(app, { beats: project.beats, endAt, total }, { movingAt: t => stage.movingAt(t) });
	const chunks = buildChunks(project.beats);
	const cap = captions(app, chunks);
	window.__VIDEO_META__ = {
		id: project.id, total, endAt, fps: project.video.fps ?? 30, motion: video.motion, fonts,
		blurWindows: stage.blurWindows, late: stage.late,
		beats: project.beats.map(b => ({ id: b.id, start: b.start, end: b.end, cues: b.cues, treatment: video.beats[b.id].treatment })),
		chunks: chunks.map(c => ({ start: c.start, end: c.end, words: c.words.map(w => ({ a: w.a, b: w.b, display: w.display })) })),
	};
	window.renderAt = t => {
		if (!Number.isFinite(t)) {
			throw new Error('renderAt(t) needs a finite time in seconds');
		}
		stage.render(t);
		window.__moving = stage.movingAt(t);
		end.render(t, endAt);
		ch.render(t);
		cap.render(t);
	};
	/** Shows one caption state (chunk c, s words said); c = -1 hides the pill. Used by the caption renderer. */
	window.showCaption = (c, s) => cap.show(c, s);
	/** Fingerprint of everything that paints in content mode; equal fingerprints render equal pixels. */
	window.frameSignature = () => {
		let s = `${mode}|`;
		for (const node of stage.root.querySelectorAll('.st-world, .st-world > *, .st-carry, .st-endcard')) {
			if (node.classList.contains('st-world')) {
				s += node.getAttribute('style') ?? '';
			} else if (node.style.display !== 'none') {
				s += node.outerHTML;
			}
		}
		s += document.querySelector('.st-chrome')?.outerHTML ?? '';
		return hash(s) + s.length.toString(36);
	};
	window.renderAt(Number(params.get('t') ?? 0));
	window.__READY__ = true;
	el('div', '', document.body).id = 'ready';
}

==> engine/scene.js  text 3634
// Authoring API for videos/<slug>/scenes.js and for catalog treatments. Pure (no DOM at definition time),
// so prs can import a scenes file in Node to verify its text and collect its code references.

/** What a beat has to explain. Every treatment serves one need; the direction picker matches beats to treatments by it. */
export const NEEDS = {
	title: 'the fixed opening frame (always the first beat)',
	concept: 'a problem, a mismatch or a few ideas side by side',
	exchange: 'messages between parties: a protocol, a handshake, a request and its reply',
	flow: 'steps in order: a pipeline, a process, a branch',
	rules: 'a rule applied to cases: validation, filtering, permissions',
	compare: 'behavior before and after the change',
	architecture: 'where the change reaches: components, processes, layers',
	code: 'the code itself: the key lines, a diff, old next to new',
	numbers: 'sizes and counts: files, lines, measurements',
	state: 'states and transitions: a lifecycle, a state machine',
	ui: 'something the user sees: a UI element, a message, a setting',
	status: 'scope, tests and what is still open',
};

export const MOTION_MODES = {
	slides: 'one slide per beat; the next appears after the last has gone',
	canvas: 'one big board; the camera flies from beat to beat (layout: row, column or grid)',
	morph: 'slides, plus one object (a token, a file, a request) that flies from beat to beat',
};

/** A video: beats keyed by the storyboard beat ids, the motion mode, and (for morph) the carried object. */
export function defineVideo(spec) {
	if (!spec || typeof spec !== 'object' || !spec.beats) {
		throw new Error('defineVideo({ motion, beats }) needs a beats object keyed by storyboard beat id');
	}
	const motion = spec.motion ?? 'slides';
	if (!Object.hasOwn(MOTION_MODES, motion)) {
		throw new Error(`Unknown motion mode "${motion}" (one of ${Object.keys(MOTION_MODES).join(', ')})`);
	}
	for (const [id, beat] of Object.entries(spec.beats)) {
		if (!beat || beat.$beat !== true) {
			throw new Error(`Beat "${id}" must be a catalog treatment call, for example exchange.lifelines({ ... })`);
		}
	}
	const layout = spec.layout ?? 'row';
	if (!['row', 'column', 'grid'].includes(layout)) {
		throw new Error(`Unknown canvas layout "${layout}" (row, column or grid)`);
	}
	if (motion === 'morph' && !spec.carry) {
		throw new Error('motion: "morph" needs carry: { text, icon, anchors: { beatId: anchorName } }');
	}
	return { $video: true, motion, layout, carry: spec.carry ?? null, beats: spec.beats };
}

/**
 * Defines a catalog treatment. Returns a factory: params -> beat spec.
 * def: { id, need, name, when, demo, region?: 'content'|'full', mount(root, params, ctx), render(instance, t, ctx) }
 */
export function defineTreatment(def) {
	for (const key of ['id', 'need', 'name', 'when', 'mount', 'render']) {
		if (!def[key]) {
			throw new Error(`Treatment ${def.id ?? '?'} is missing ${key}`);
		}
	}
	if (!Object.hasOwn(NEEDS, def.need)) {
		throw new Error(`Treatment ${def.id} has unknown need ${def.need}`);
	}
	const factory = (params = {}) => ({ $beat: true, treatment: def.id, need: def.need, params, impl: def });
	factory.meta = { id: def.id, need: def.need, name: def.name, when: def.when, demo: def.demo ?? null, params: def.params ?? null };
	return factory;
}

/** Timing references usable in any `at`: a cue name ('step1'), word('401'), cue('step1', 0.4), or seconds after the beat starts (1.2). */
export const word = (text, opts = {}) => ({ $word: String(text), nth: opts.nth ?? 0, offset: opts.offset ?? 0 });
export const cue = (name, offset = 0) => ({ $cue: String(name), offset });

==> engine/stage.js  text 14850
// The stage: mounts every beat's treatment and moves between beats according to the video's motion mode.
//   slides  one slide per beat; the outgoing slide is gone before the next appears
//   canvas  every beat is a panel on one board; the camera flies from panel to panel (layout: row, column, grid)
//   morph   slides, plus one carried object that flies from an anchor in one beat to an anchor in the next
import { el, pill } from '../theme/primitives.js';
import { FILL } from '../theme/tokens.js';
import { clamp, decel, easeInOutCubic, lerp, prog, standard } from './motion.js';
import { codeKey } from './text.js';

const PANEL_GAP = 220;
const norm = s => String(s).toLowerCase().replace(/[^a-z0-9/.-]/g, '');

function panelPosition(layout, k) {
	if (layout === 'column') {
		return { x: 0, y: k * (1080 + PANEL_GAP) };
	}
	if (layout === 'grid') {
		const row = Math.floor(k / 3), col = k % 3;
		const c = row % 2 === 0 ? col : 2 - col;
		return { x: c * (1920 + PANEL_GAP), y: row * (1080 + PANEL_GAP) };
	}
	return { x: k * (1920 + PANEL_GAP), y: 0 };
}

/** Resolves a timing reference inside a beat to absolute seconds; every explicit time is recorded for the lint. */
function makeAt(beat, seen) {
	const at = (ref, fallback) => {
		const t = resolve(ref, fallback);
		if (ref !== undefined && ref !== null) {
			seen.push({ t, ref: typeof ref === 'object' ? JSON.stringify(ref) : String(ref) });
		}
		return t;
	};
	const resolve = (ref, fallback) => {
		if (ref === undefined || ref === null) {
			if (fallback === undefined) {
				throw new Error(`Beat "${beat.id}": a time is required`);
			}
			return at(fallback);
		}
		if (typeof ref === 'number') {
			return beat.start + ref;
		}
		if (ref === undefined || ref === null) {
			return resolve(fallback);
		}
		if (typeof ref === 'string') {
			if (!Object.hasOwn(beat.cues, ref)) {
				throw new Error(`Beat "${beat.id}": unknown cue "${ref}". Cues: ${Object.keys(beat.cues).join(', ') || '(none)'}. Add it to the storyboard or use word('...').`);
			}
			return beat.cues[ref];
		}
		if (ref.$cue !== undefined) {
			return resolve(ref.$cue) + (ref.offset ?? 0);
		}
		if (ref.$word !== undefined) {
			const want = norm(ref.$word);
			// The word itself first ('To' is "to", not "tool"); a prefix only when the word isn't there whole.
			const exact = beat.words.filter(w => norm(w.display) === want);
			const hits = exact.length > (ref.nth ?? 0) ? exact : beat.words.filter(w => norm(w.display).startsWith(want));
			const hit = hits[ref.nth ?? 0];
			if (!hit) {
				throw new Error(`Beat "${beat.id}": word "${ref.$word}" (#${ref.nth ?? 0}) is not in its narration`);
			}
			return hit.a + (ref.offset ?? 0);
		}
		throw new Error(`Beat "${beat.id}": cannot read time ${JSON.stringify(ref)}`);
	};
	return at;
}

export function createStage(app, video, project) {
	const { endAt } = project.video;
	const motion = video.motion;
	const layout = video.layout ?? 'row';
	const root = el('div', 'st-stage', app);
	const world = el('div', 'st-world', root);
	const panels = project.beats.map((_, k) => (motion === 'canvas' ? panelPosition(layout, k) : { x: 0, y: 0 }));
	const extent = panels.reduce((a, p) => ({ w: Math.max(a.w, p.x + 1920), h: Math.max(a.h, p.y + 1080) }), { w: 1920, h: 1080 });
	let board = null;
	if (motion === 'canvas') {
		board = el('div', 'st-abs', world, {
			left: -600, top: -600, width: extent.w + 1200, height: extent.h + 1200, opacity: 0,
			backgroundImage: 'radial-gradient(circle, #d9dee6 1.6px, transparent 2px)', backgroundSize: '44px 44px',
		});
	}
	const carryLayer = el('div', 'st-layer', root);
	const anchors = new Map();
	const entries = project.beats.map((beat, index) => {
		const spec = video.beats[beat.id];
		if (!spec) {
			throw new Error(`scenes.js has no beat "${beat.id}" (storyboard beats: ${project.beats.map(b => b.id).join(', ')})`);
		}
		const host = el('section', 'st-beat', world, { left: panels[index].x, top: panels[index].y });
		host.dataset.beat = beat.id;
		let frame = null;
		if (motion === 'canvas') {
			frame = el('div', 'st-abs', host, { left: 0, top: 0, width: 1920, height: 1080, borderRadius: 32, border: '2px solid #dfe3ea', background: '#fff', opacity: 0 });
		}
		const content = el('div', 'st-layer', host);
		const seen = [];
		const ctx = {
			beat: { ...beat, index, duration: beat.end - beat.start, need: spec.need },
			at: makeAt(beat, seen),
			has: name => Object.hasOwn(beat.cues, name),
			facts: project.pr.facts,
			code(ref) {
				const block = project.code?.[codeKey(ref)];
				if (!block) {
					throw new Error(`Beat "${beat.id}": code ${ref.file} is not prepared. Run prs prepare.`);
				}
				return block;
			},
			anchor(name, node) {
				anchors.set(`${beat.id}:${name}`, node);
				return node;
			},
			motion,
			video,
			project,
		};
		let instance;
		try {
			instance = spec.impl.mount(content, spec.params ?? {}, ctx) ?? {};
		} catch (error) {
			throw new Error(`Beat "${beat.id}" (${spec.treatment}): ${error.message}`);
		}
		return { beat, spec, host, frame, content, ctx, instance, panel: panels[index], seen };
	});
	// Anything timed after its beat starts leaving is never seen: report it.
	const late = [];
	entries.forEach((entry, k) => {
		const leaves = k === entries.length - 1 ? endAt - 0.25 : entry.beat.end - (motion === 'canvas' ? 0.15 : 0.08);
		for (const s of entry.seen) {
			if (s.t > leaves - 0.3) {
				late.push({ beat: entry.beat.id, at: +s.t.toFixed(2), leaves: +leaves.toFixed(2), ref: s.ref });
			}
		}
	});
	for (const entry of entries) {
		try {
			entry.instance.layout?.();
		} catch (error) {
			throw new Error(`Beat "${entry.beat.id}" (${entry.spec.treatment}) layout: ${error.message}`);
		}
	}
	// Treatments lay their parts out at fixed sizes from the top of the content area, so a short body leaves the lower
	// half of the frame empty. Fit each body (not the heading, not the title frame) to the room above the captions.
	if (video.fill !== false) {
		for (const entry of entries) {
			if (entry.spec.need !== 'title') {
				fillBody(entry);
			}
		}
	}

	// morph: a carried object flies between anchors of consecutive beats
	const carry = video.carry;
	const flights = [];
	let carryNode = null;
	if (motion === 'morph' && carry) {
		carryNode = el('div', 'st-carry', carryLayer);
		carryNode.dataset.flight = 'carry';
		pill(carryNode, { tone: carry.tone ?? 'blue', text: carry.text, iconName: carry.icon, size: 'l', style: { boxShadow: '0 10px 30px rgba(0, 95, 184, .18)' } });
		const rectOf = (id, name) => {
			const node = anchors.get(`${id}:${name}`);
			if (!node) {
				throw new Error(`carry: beat "${id}" has no anchor "${name}"`);
			}
			const r = node.getBoundingClientRect();
			return { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
		};
		const ids = entries.map(e => e.beat.id).filter(id => carry.anchors?.[id]);
		for (let i = 0; i + 1 < ids.length; i++) {
			const a = entries.find(e => e.beat.id === ids[i]);
			const b = entries.find(e => e.beat.id === ids[i + 1]);
			if (b.ctx.beat.index !== a.ctx.beat.index + 1) {
				continue;
			}
			flights.push({ t0: a.beat.end - 0.12, t1: b.beat.start + 0.55, from: rectOf(a.beat.id, carry.anchors[a.beat.id]), to: rectOf(b.beat.id, carry.anchors[b.beat.id]) });
		}
	}

	// canvas: camera moves between panels
	const moves = [];
	if (motion === 'canvas') {
		for (let k = 1; k < entries.length; k++) {
			const a = entries[k - 1], b = entries[k];
			const ca = { x: a.panel.x + 960, y: a.panel.y + 540 }, cb = { x: b.panel.x + 960, y: b.panel.y + 540 };
			const dist = Math.hypot(cb.x - ca.x, cb.y - ca.y);
			moves.push({ t0: a.beat.end - 0.15, t1: b.beat.start + 0.6, ca, cb, dip: Math.min(0.3, 0.12 + dist / 16000) });
		}
	}
	const blurWindows = moves.map(m => [m.t0, m.t1]);

	function cameraAt(t) {
		let c = { x: entries[0].panel.x + 960, y: entries[0].panel.y + 540 }, z = 1, moving = 0;
		for (const m of moves) {
			if (t >= m.t1) {
				c = m.cb;
			} else if (t > m.t0) {
				const p = standard(prog(t, m.t0, m.t1));
				c = { x: lerp(m.ca.x, m.cb.x, p), y: lerp(m.ca.y, m.cb.y, p) };
				z = 1 - m.dip * Math.sin(Math.PI * p);
				moving = Math.sin(Math.PI * prog(t, m.t0, m.t1));
				break;
			}
		}
		return { c, z, moving };
	}

	function slideStyle(entry, t, k) {
		const { beat } = entry;
		const last = k === entries.length - 1;
		const exitStart = last ? endAt - 0.25 : beat.end - 0.08;
		const visible = t >= beat.start - 0.35 && t <= exitStart + 0.45;
		const inP = k === 0 ? 1 : easeInOutCubic(clamp((prog(t, beat.start - 0.28, beat.start + 0.34) - 0.3) / 0.7));
		const outP = easeInOutCubic(clamp(prog(t, exitStart, exitStart + 0.4) * 1.7));
		return { visible, opacity: inP * (1 - outP), y: lerp(10, 0, inP) - 8 * outP };
	}

	return {
		root, entries, blurWindows, anchors, late,
		/** 0..1: how much the camera is moving at t (canvas mode), so fixed chrome can step aside. */
		movingAt(t) {
			return motion === 'canvas' ? cameraAt(t).moving : 0;
		},
		render(t) {
			if (motion === 'canvas') {
				const cam = cameraAt(t);
				world.style.transform = `translate(${960 - cam.c.x * cam.z}px, ${540 - cam.c.y * cam.z}px) scale(${cam.z})`;
				board.style.opacity = String(cam.moving * 0.9);
				const lastExit = decel(prog(t, endAt - 0.25, endAt + 0.25));
				entries.forEach((entry, k) => {
					const { panel } = entry;
					const sx = (panel.x - cam.c.x) * cam.z + 960, sy = (panel.y - cam.c.y) * cam.z + 540;
					const visible = sx < 1920 + 40 && sx + 1920 * cam.z > -40 && sy < 1080 + 40 && sy + 1080 * cam.z > -40 && !(k === entries.length - 1 && lastExit >= 1);
					entry.host.style.display = visible ? 'block' : 'none';
					entry.host.style.opacity = k === entries.length - 1 ? String(1 - lastExit) : '1';
					entry.frame.style.opacity = String(cam.moving);
					if (visible) {
						entry.spec.impl.render(entry.instance, t, entry.ctx);
					}
				});
			} else {
				entries.forEach((entry, k) => {
					const s = slideStyle(entry, t, k);
					entry.host.style.display = s.visible ? 'block' : 'none';
					if (!s.visible) {
						return;
					}
					entry.host.style.opacity = String(s.opacity);
					entry.host.style.transform = `translate3d(0, ${s.y}px, 0)`;
					entry.spec.impl.render(entry.instance, t, entry.ctx);
				});
			}
			if (carryNode) {
				const f = flights.find(fl => t > fl.t0 && t < fl.t1);
				carryNode.style.display = f ? 'block' : 'none';
				if (f) {
					const p = standard(prog(t, f.t0, f.t1));
					const w = carryNode.offsetWidth, h = carryNode.offsetHeight;
					const x = lerp(f.from.cx, f.to.cx, p) - w / 2;
					const y = lerp(f.from.cy, f.to.cy, p) - h / 2 - 110 * Math.sin(Math.PI * p);
					const fade = Math.min(prog(t, f.t0, f.t0 + 0.12), 1 - prog(t, f.t1 - 0.18, f.t1));
					carryNode.style.transform = `translate(${x}px, ${y}px) scale(${1 + 0.06 * Math.sin(Math.PI * p)})`;
					carryNode.style.opacity = String(fade);
				}
			}
		},
	};
}

const SHAPES = new Set(['path', 'line', 'polyline', 'polygon', 'circle', 'ellipse', 'rect', 'text', 'image', 'use', 'img', 'canvas', 'video']);
const NOT_DRAWN = new Set(['defs', 'marker', 'clippath', 'mask', 'pattern', 'lineargradient', 'radialgradient', 'filter', 'style', 'script']);
const clear = color => !color || color === 'transparent' || /rgba\([^)]*,\s*0\)$/.test(color);
/** Whether a box paints something of its own: a fill, a background image, a visible border or a ring. */
function paints(cs) {
	const border = ['Top', 'Right', 'Bottom', 'Left'].some(side => parseFloat(cs[`border${side}Width`]) > 0 && !clear(cs[`border${side}Color`]));
	return !clear(cs.backgroundColor) || cs.backgroundImage !== 'none' || border || (cs.boxShadow && cs.boxShadow !== 'none');
}

/** Scales a beat's body up (never down, at most FILL.max) to fill the room between its heading and the caption band,
 * centred vertically and kept inside the side margins. The body is measured across its whole beat (parts may move or
 * arrive while it plays), once: everything inside keeps its own coordinates and motion, and later measurements (the
 * morph anchors, the lint) see the fitted result. */
function fillBody(entry) {
	const { content, beat } = entry;
	const body = [...content.children].filter(node => node.dataset.head === undefined);
	if (!body.length) {
		return;
	}
	const display = entry.host.style.display;
	entry.host.style.display = 'block';
	let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
	const range = document.createRange();
	const add = (r, origin) => {
		if (r.width >= 1 && r.height >= 1) {
			x0 = Math.min(x0, r.left - origin.left);
			y0 = Math.min(y0, r.top - origin.top);
			x1 = Math.max(x1, r.right - origin.left);
			y1 = Math.max(y1, r.bottom - origin.top);
		}
	};
	// What is drawn, where it is visible now: text by its own extent, SVG shapes, and boxes that paint (a fill, a
	// border, a ring). Invisible parts (a marker parked until its path starts) and empty containers don't count.
	const walk = (n, origin) => {
		const cs = getComputedStyle(n);
		const tag = n.tagName.toLowerCase();
		if (cs.display === 'none' || Number(cs.opacity) < 0.01 || NOT_DRAWN.has(tag)) {
			return;
		}
		if (cs.visibility !== 'hidden') {
			if (SHAPES.has(tag) || paints(cs)) {
				add(n.getBoundingClientRect(), origin);
			}
			for (const c of n.childNodes) {
				if (c.nodeType === 3 && c.textContent.trim()) {
					range.selectNodeContents(c);
					add(range.getBoundingClientRect(), origin);
				}
			}
		}
		for (const c of n.children) {
			walk(c, origin);
		}
	};
	const measure = () => {
		const origin = content.getBoundingClientRect();
		for (const node of body) {
			walk(node, origin);
		}
	};
	// Sampled through the beat, about every 0.4 s: parts may move or arrive while it plays.
	const samples = Math.min(60, Math.max(8, Math.ceil((beat.end - beat.start) / 0.4)));
	for (let i = 0; i <= samples; i++) {
		entry.spec.impl.render(entry.instance, beat.start + ((beat.end - beat.start) * i) / samples, entry.ctx);
		measure();
	}
	entry.host.style.display = display;
	if (!Number.isFinite(x0)) {
		return;
	}
	const w = x1 - x0, h = y1 - y0;
	const k = Math.max(1, Math.min(FILL.max, (FILL.x1 - FILL.x0) / w, (FILL.y1 - FILL.y0) / h));
	// Around its own centre horizontally (a left-aligned body stays left, a centred one centred), then into the margins.
	const left = Math.min(Math.max((x0 + x1) / 2 - (w * k) / 2, FILL.x0), FILL.x1 - w * k);
	const top = Math.max(FILL.y0, (FILL.y0 + FILL.y1) / 2 - (h * k) / 2);
	const tx = left - x0 * k, ty = top - y0 * k;
	if (k === 1 && Math.abs(tx) < 2 && Math.abs(ty) < 2) {
		return;
	}
	const wrap = el('div', 'st-layer', content);
	wrap.dataset.fill = k.toFixed(3);
	wrap.style.transformOrigin = '0 0';
	wrap.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${k.toFixed(4)})`;
	wrap.append(...body);
}

==> engine/text.js  text 5604
// Where on-screen text comes from. Pure (no DOM): imported both by Node (prs prepare verifies every reference
// against the PR before anything renders) and by the browser (which resolves them to strings).
//
//   label('The fix')                         microcopy written by the agent (the reviewer checks it)
//   fact('additions', { format: 'n' })       a value from pr.json facts, never retyped
//   quote('contact your administrator')      an exact substring of the PR body, diff, tests, title or commits
//   ident('isSameSecureOrigin')              an identifier that appears in the PR's diff or changed files
//   path('src/vs/.../file.ts')               a file the PR changes (shown as basename by default)
//   code('src/vs/.../file.ts', { from, to }) source lines at the PR head commit (tokenized at prepare time)
//
// Arrays combine parts: [fact('changedFiles'), label(' files')]. Plain strings are labels.

export const label = (text, opts = {}) => ({ $text: 'label', text: String(text), ...opts });
export const fact = (path, opts = {}) => ({ $text: 'fact', path, format: opts.format, prefix: opts.prefix ?? '', suffix: opts.suffix ?? '' });
export const quote = (text, opts = {}) => ({ $text: 'quote', text: String(text), where: opts.in ?? 'any' });
export const ident = name => ({ $text: 'ident', text: String(name) });
export const path = (filePath, opts = {}) => ({ $text: 'path', path: String(filePath), show: opts.show ?? 'basename' });
export const code = (file, selection = {}) => ({ $code: true, file: String(file), ...selection });

export function isText(value) {
	return !!value && typeof value === 'object' && typeof value.$text === 'string';
}

export function isCode(value) {
	return !!value && typeof value === 'object' && value.$code === true;
}

/** Stable key for a code reference (Node and browser compute the same one); every option is part of it. */
export function codeKey(ref) {
	return JSON.stringify(Object.keys(ref).filter(k => k !== '$code').sort().map(k => [k, ref[k]]));
}

export function getPath(root, dotted) {
	let current = root;
	for (const part of String(dotted).split('.')) {
		if (current === null || current === undefined || !Object.hasOwn(Object(current), part)) {
			return undefined;
		}
		current = current[part];
	}
	return current;
}

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

export function formatFact(value, format) {
	if (value === undefined || value === null) {
		return '';
	}
	switch (format) {
		case 'n':
			return Number(value).toLocaleString('en-US');
		case 'date': {
			const d = new Date(value);
			return `${d.getUTCDate()} ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
		}
		case 'lower':
			return String(value).toLowerCase();
		case 'state':
			return { OPEN: 'Open', MERGED: 'Merged', CLOSED: 'Closed' }[value] ?? String(value);
		case 'review':
			return { REVIEW_REQUIRED: 'Review required', APPROVED: 'Approved', CHANGES_REQUESTED: 'Changes requested' }[value] ?? String(value).toLowerCase().replace(/_/g, ' ');
		default:
			return String(value);
	}
}

function basename(p) {
	return p.split('/').pop();
}

/** -> { text, src } for one part. src goes into data-src so the linter can see where every string came from. */
export function resolvePart(value, facts) {
	if (value === null || value === undefined) {
		return { text: '', src: 'label' };
	}
	if (isCode(value)) {
		throw new Error(`code('${value.file}') is not text: show a file with path('${value.file}') or a name with ident('...'); code() goes in params that take code`);
	}
	if (!isText(value)) {
		if (typeof value === 'object') {
			throw new Error(`not text: ${JSON.stringify(value).slice(0, 80)}. Use label(), fact(), quote(), ident() or path()`);
		}
		return { text: String(value), src: 'label' };
	}
	switch (value.$text) {
		case 'label':
			return { text: value.text, src: 'label' };
		case 'fact': {
			const raw = getPath(facts ?? {}, value.path);
			if (raw === undefined) {
				throw new Error(`fact('${value.path}') is not in pr.json facts`);
			}
			return { text: `${value.prefix}${formatFact(raw, value.format)}${value.suffix}`, src: `fact:${value.path}` };
		}
		case 'quote':
			return { text: value.text, src: `quote:${value.where}` };
		case 'ident':
			return { text: value.text, src: 'ident' };
		case 'path': {
			const parts = value.path.split('/');
			const shown = value.show === 'full' ? value.path
				: value.show === 'dir' ? parts.slice(0, -1).join('/')
					: value.show === 'tail2' ? parts.slice(-2).join('/')
						: basename(value.path);
			return { text: shown, src: 'path' };
		}
		default:
			throw new Error(`Unknown text kind ${value.$text}`);
	}
}

/** Flattens a text value (part or array of parts) into parts. */
export function textParts(value, facts) {
	const list = Array.isArray(value) ? value : [value];
	return list.map(part => resolvePart(part, facts));
}

export function textOf(value, facts) {
	return textParts(value, facts).map(part => part.text).join('');
}

/** Walks any params object and yields every text and code reference (used by prs prepare). */
export function* walkRefs(value, trail = '') {
	if (Array.isArray(value)) {
		for (let i = 0; i < value.length; i++) {
			yield* walkRefs(value[i], `${trail}[${i}]`);
		}
		return;
	}
	if (!value || typeof value !== 'object') {
		return;
	}
	if (isText(value) || isCode(value)) {
		yield { ref: value, trail };
		return;
	}
	for (const [key, child] of Object.entries(value)) {
		if (key === 'impl') {
			continue;
		}
		yield* walkRefs(child, trail ? `${trail}.${key}` : key);
	}
}

